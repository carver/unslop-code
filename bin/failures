#!/usr/bin/env python3
"""Compare failing tests for one problem across two runs.

Usage: bin/failures <run_a> <run_b> <problem> [--messages]
Prints, per checkpoint, every test that fails in either run, tagged a / b / both,
with its group. --messages adds the tail of each failure's pytest output for run b.
"""
import json, sys, pathlib

def fails(run, problem, ck):
    p = pathlib.Path(run) / problem / f"checkpoint_{ck}" / "evaluation.json"
    if not p.exists():
        return None
    out = {}
    for grp, v in json.load(open(p))["tests"].items():
        for st, names in v.items():
            if st != "passed":
                for n in names:
                    out[n] = (grp, st)
    return out

def messages(run, problem, ck):
    p = pathlib.Path(run) / problem / f"checkpoint_{ck}" / "evaluation" / "report.json"
    if not p.exists():
        return {}
    d = json.load(open(p))
    return {t["nodeid"].split("::", 1)[-1]: str((t.get("call") or {}).get("longrepr", ""))[-500:]
            for t in d.get("tests", []) if t.get("outcome") != "passed"}

def main():
    a, b, problem = sys.argv[1:4]
    show = "--messages" in sys.argv
    ncks = len(list((pathlib.Path(b) / problem).glob("checkpoint_*")))
    for ck in range(1, ncks + 1):
        fa, fb = fails(a, problem, ck), fails(b, problem, ck)
        if fa is None or fb is None:
            print(f"\n== {problem} checkpoint {ck}: missing in {'a' if fa is None else 'b'}"); continue
        print(f"\n== {problem} checkpoint {ck}: a fails {len(fa)}, b fails {len(fb)}, shared {len(set(fa) & set(fb))}")
        msgs = messages(b, problem, ck) if show else {}
        for n in sorted(set(fa) | set(fb)):
            who = "both" if n in fa and n in fb else ("a" if n in fa else "b")
            grp = (fb.get(n) or fa.get(n))[0]
            print(f"   {who:4s} {grp:28s} {n}")
            if show and who != "a" and n in msgs:
                print("        " + msgs[n].strip().replace("\n", "\n        ")[-400:])

main()
