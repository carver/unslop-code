#!/usr/bin/env python3
"""The uplift grid: two prompts by two specs, per problem and averaged across problems.

    bin/grid [--json] [--prompts A,B] [--model opus-5]

Rows are problems; the four cells are (prompt, spec) with spec v0 (the cached benchmark
spec) and "patched", the highest spec version that BOTH prompts have a complete run on, so
the two prompts are always compared on the same words. Every figure is one where lower is
better: fail% is the share of hidden tests failed at the last checkpoint (1 - score), the
four quality means are as bin/results reports them, cost is cc_$ per run, minutes the run's
wall clock (checkpoint end minus start, summed). A cell lists its
runs and their mean; the bottom rows average the cell means over the problems that have the
cell (n says how many). --json prints the same structure for a page to draw from.

Prompts default to the benchmark's just-solve and min12-ABDJKMN, the pair the 2x2 uplift
experiment compares (notes/uplift-grid.md). Runs are read the way bin/results reads them.

The JSON also carries "trajectory": erosion per progress phase for each prompt's v0 runs, the
paper's five-phase view of a run (Start, Early, Mid, Late, Final) so the page can lay the two
prompts over Figure 5 of arXiv 2603.24755v2.
"""
import json
import pathlib
import sys
import types

HERE = pathlib.Path(__file__).resolve().parent
results = types.ModuleType("results"); results.__file__ = str(HERE / "results")
sys.modules["results"] = results
exec(compile((HERE / "results").read_text(), str(HERE / "results"), "exec"), results.__dict__)

METRICS = ("fail", "erosion", "verbosity", "ast", "cloned", "cost", "minutes")
DEFAULT_PROMPTS = ("just-solve", "min12-ABDJKMN")
PHASES = ("Start", "Early", "Mid", "Late", "Final")


def run_figures(run):
    """A run's row of the grid: fail% and the quality means, all lower-is-better."""
    return {"fail": 1 - run["score"], "erosion": run["erosion"], "verbosity": run["verbosity"],
            "ast": run["ast"], "cloned": run["cloned"], "cost": run["cost"], "minutes": run["minutes"]}


def spec_number(spec):
    return int(spec.removeprefix("v"))


def patched_spec(cells, problem, prompts, model):
    """The highest spec version every prompt has a complete run on, or None."""
    versions = None
    for prompt in prompts:
        have = {spec for (p, pr, spec, m) in cells if p == problem and pr == prompt and m == model and spec != "v0"}
        versions = have if versions is None else versions & have
    return max(versions, key=spec_number) if versions else None


def phase_of(idx, count):
    """Which of PHASES checkpoint idx (0-based) of a count-checkpoint run falls in.

    The paper's rule (arXiv 2603.24755v2, section 3): the first checkpoint is Start, the last is
    Final, and the interior ones split into Early, Mid and Late. It does not say how an interior
    that is not a multiple of three splits; here each interior checkpoint goes by the third its
    centre falls in, so two interior checkpoints are Early and Late, four are Early, Mid, Mid, Late."""
    if idx == 0:
        return 0
    if idx == count - 1:
        return len(PHASES) - 1
    return 1 + int(3 * (idx - 0.5) / (count - 2))


def trajectory(cells, prompts=DEFAULT_PROMPTS, model="opus-5", spec="v0"):
    """{"spec": spec, "phases": [...], "prompts": {prompt: {"runs": k, "ckpts": [per phase], "erosion": [per phase]}}}:
    each prompt's checkpoints at that spec, pooled over its runs on every problem, meaned by phase."""
    out = {"spec": spec, "phases": list(PHASES), "prompts": {}}
    for prompt in prompts:
        pools = [[] for _ in PHASES]
        runs = 0
        for (p, pr, sp, m), summaries in cells.items():
            if pr != prompt or sp != spec or m != model:
                continue
            for run in summaries:
                runs += 1
                by_ckpt = run["erosion_by_ckpt"]
                for idx, erosion in enumerate(by_ckpt):
                    if erosion is not None:
                        pools[phase_of(idx, len(by_ckpt))].append(erosion)
        out["prompts"][prompt] = {"runs": runs, "ckpts": [len(x) for x in pools], "erosion": [results.mean(x) for x in pools]}
    return out


def cell_means(runs):
    return {k: results.mean([r[k] for r in runs]) for k in METRICS}


def grid(cells, prompts=DEFAULT_PROMPTS, model="opus-5"):
    """{"prompts": [...], "problems": {problem: {"patched": "vN" | None, "cells": {"prompt|v0": {...}, "prompt|patched": {...}}}},
        "means": {"prompt|v0": {"n": k, **means}, ...}} with every cell {"spec": "vN", "runs": [...], "mean": {...}}."""
    problems = sorted({p for (p, pr, spec, m) in cells if pr in prompts and m == model})
    out = {"prompts": list(prompts), "problems": {}, "means": {}}
    for problem in problems:
        patched = patched_spec(cells, problem, prompts, model)
        entry = {"patched": patched, "cells": {}}
        for prompt in prompts:
            for kind, spec in (("v0", "v0"), ("patched", patched)):
                runs = cells.get((problem, prompt, spec, model), []) if spec else []
                if runs:
                    figures = [run_figures(r) for r in runs]
                    entry["cells"][f"{prompt}|{kind}"] = {"spec": spec, "runs": figures, "mean": cell_means(figures)}
        out["problems"][problem] = entry
    for prompt in prompts:
        for kind in ("v0", "patched"):
            key = f"{prompt}|{kind}"
            means = [e["cells"][key]["mean"] for e in out["problems"].values() if key in e["cells"]]
            if means:
                out["means"][key] = {"n": len(means), **cell_means(means)}
    out["trajectory"] = trajectory(cells, prompts, model)
    return out


def pct(v):
    return "-" if v is None else f"{100 * v:.1f}%"


def cell_text(cell):
    if cell is None:
        return "-"
    m = cell["mean"]
    return f"{pct(m['fail'])} / {m['erosion']:.2f} / {m['ast']:.2f} / ${m['cost']:.0f} / {m['minutes']:.0f}m ({len(cell['runs'])})"


def table(g):
    """Markdown: one row per problem, cells 'fail% / erosion / ast% / $ / minutes (runs)', then the means."""
    a, b = g["prompts"]
    heads = [f"{a} v0", f"{b} v0", f"{b} patched", f"{a} patched"]
    keys = [f"{a}|v0", f"{b}|v0", f"{b}|patched", f"{a}|patched"]
    lines = ["| problem | patched | " + " | ".join(heads) + " |", "|---|---|" + "---|" * 4]
    for problem, e in g["problems"].items():
        lines.append(f"| {problem} | {e['patched'] or '-'} | " + " | ".join(cell_text(e["cells"].get(k)) for k in keys) + " |")
    means = [g["means"].get(k) for k in keys]
    ns = {m["n"] for m in means if m}
    n = f"n={'/'.join(str(x) for x in sorted(ns))}"
    lines.append(f"| mean | {n} | " + " | ".join("-" if m is None else f"{pct(m['fail'])} / {m['erosion']:.2f} / {m['ast']:.2f} / ${m['cost']:.0f} / {m['minutes']:.0f}m ({m['n']})" for m in means) + " |")
    return "\n".join(lines)


def main():
    args = sys.argv[1:]
    as_json = "--json" in args
    prompts = DEFAULT_PROMPTS
    model = "opus-5"
    if "--prompts" in args:
        prompts = tuple(args[args.index("--prompts") + 1].split(","))
    if "--model" in args:
        model = args[args.index("--model") + 1]
    cells, _ = results.collect(results.run_dirs())
    g = grid(cells, prompts, model)
    print(json.dumps(g, indent=1) if as_json else table(g))


if __name__ == "__main__":
    main()
