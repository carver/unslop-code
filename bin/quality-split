#!/usr/bin/env python3
"""Quality scores of implementation files against test files, per problem and prompt.

    bin/quality-split [--json] [--prompts A,B] [--model opus-5] [--set dev|test|all]
    bin/quality-split [--json] --tree DIR [--tree DIR ...]

scb-check scores every Python file in a snapshot, tests included, so a prompt that writes
more tests moves its scores without touching its implementation. For the final checkpoint of
each v0 run this copies the implementation files and the test files (named `test*`,
`*_test.py`, `conftest.py`, or under `tests/` or `testing/`) into two trees and runs the
pinned scb-check on each, and on the whole snapshot. A cell pools its runs: ast% and cloned%
are flagged lines over LOC, erosion is high-complexity mass over total mass. --tree does the
same for any directory, such as a checkout of a human-written repository.
Reports are cached under outputs/quality-hits/split/.
"""
import argparse
import hashlib
import json
import pathlib
import shutil
import subprocess
import sys
import tempfile
import types

HERE = pathlib.Path(__file__).resolve().parent
ROOT = HERE.parent
results = types.ModuleType("results")
results.__file__ = str(HERE / "results")
sys.modules["results"] = results
exec(compile((HERE / "results").read_text(), str(HERE / "results"), "exec"), results.__dict__)
sys.path.insert(0, str(ROOT / "report"))
import scb_hits  # noqa: E402

CACHE = ROOT / "outputs" / "quality-hits" / "split"
PARTS = ("impl", "test", "all")
SKIPPED_DIRS = {".git", "docs", "doc", ".venv", "venv", "env", "__pycache__", "node_modules", "site-packages", ".tox",
                "build", "dist"}
SUMMED = ("total_loc", "ast_grep_flagged_loc", "clone_loc", "high_cc_mass", "total_mass")


def part_of(path):
    return "test" if scb_hits.is_test_file(str(path)) else "impl"


def python_files(tree):
    return sorted(p.relative_to(tree) for p in tree.rglob("*.py")
                  if p.is_file() and not SKIPPED_DIRS.intersection(p.relative_to(tree).parts))


def scb_report(directory):
    command = ["uvx", f"scb-check=={scb_hits.SCB_CHECK_VERSION}", "check", "--report", "--include-all", "."]
    return json.loads(subprocess.run(command, cwd=directory, capture_output=True, text=True, check=True).stdout)


def part_report(tree, part, check=scb_report):
    files = [f for f in python_files(tree) if part == "all" or part_of(f) == part]
    if not files:
        return dict.fromkeys(SUMMED, 0)
    with tempfile.TemporaryDirectory() as scratch:
        for f in files:
            target = pathlib.Path(scratch) / f
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(tree / f, target)
        report = check(scratch)
    return {k: report[k] for k in SUMMED}


def split_reports(tree, cache=CACHE, check=scb_report):
    key = hashlib.sha256(f"{scb_hits.SCB_CHECK_VERSION}:{tree.resolve()}".encode()).hexdigest()[:16]
    cached = pathlib.Path(cache) / f"{key}.json"
    if not cached.exists():
        cached.parent.mkdir(parents=True, exist_ok=True)
        cached.write_text(json.dumps({part: part_report(tree, part, check) for part in PARTS}))
    return json.loads(cached.read_text())


def ratio(top, bottom):
    return top / bottom if bottom else None


def pooled(runs):
    """One row from a cell's runs: per part, LOC and the three scores over the summed counts."""
    row = {"runs": len(runs)}
    for part in PARTS:
        total = {k: sum(r[part][k] for r in runs) for k in SUMMED}
        row[part] = {"loc": total["total_loc"], "ast_lines": total["ast_grep_flagged_loc"],
                     "ast": ratio(total["ast_grep_flagged_loc"], total["total_loc"]),
                     "cloned": ratio(total["clone_loc"], total["total_loc"]),
                     "erosion": ratio(total["high_cc_mass"], total["total_mass"])}
    row["test_share"] = ratio(row["test"]["loc"], row["impl"]["loc"] + row["test"]["loc"])
    return row


def final_checkpoint(problem_dir):
    scored = [c for c in problem_dir.glob("checkpoint_*") if (c / "quality_analysis" / "scb_check.json").exists()]
    return max(scored, key=lambda c: int(c.name.rsplit("_", 1)[1]), default=None)


def collect(prompts, model, problems):
    cells = {}
    for run in results.run_dirs():
        prompt, spec, run_model = results.cell_key(run)
        if prompt not in prompts or spec != "v0" or run_model != model:
            continue
        for problem_dir in (d for d in run.iterdir() if d.is_dir() and (problems is None or d.name in problems)):
            checkpoint = final_checkpoint(problem_dir)
            if checkpoint:
                cells.setdefault((problem_dir.name, prompt), []).append(split_reports(checkpoint / "snapshot"))
    return cells


def rows_for_runs(prompts, model, problems):
    cells = collect(prompts, model, problems)
    rows = []
    for prompt in prompts:
        by_problem = {problem: runs for (problem, p), runs in sorted(cells.items()) if p == prompt}
        everything = [run for runs in by_problem.values() for run in runs]
        rows += [{"name": problem, "prompt": prompt, **pooled(cell)}
                 for problem, cell in [*by_problem.items(), ("ALL", everything)] if cell]
    return rows


def fmt(share):
    return "-" if share is None else f"{share:.3f}"


def table(rows):
    lines = ["| name | prompt | runs | impl LOC | test LOC | test share | ast impl / test / all "
             "| erosion impl / test / all | cloned impl / test / all |", "|---|---|---|---|---|---|---|---|---|"]
    for row in rows:
        triples = (" / ".join(fmt(row[part][score]) for part in PARTS) for score in ("ast", "erosion", "cloned"))
        scores = " | ".join(triples)
        lines.append(f"| {row['name']} | {row.get('prompt', '-')} | {row['runs']} | {row['impl']['loc']} | "
                     f"{row['test']['loc']} | {row['test_share']:.0%} | {scores} |")
    return "\n".join(lines)


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--prompts", default="just-solve,min12-ABDJKMN")
    parser.add_argument("--model", default="opus-5")
    parser.add_argument("--set", default="dev", choices=["dev", "test", "all"])
    parser.add_argument("--tree", action="append", type=pathlib.Path, default=[])
    args = parser.parse_args()
    if args.tree:
        rows = [{"name": tree.name, **pooled([split_reports(tree)])} for tree in args.tree]
    else:
        problems = None if args.set == "all" else set(json.loads((ROOT / "split.json").read_text())[args.set])
        rows = rows_for_runs(args.prompts.split(","), args.model, problems)
    print(json.dumps(rows, indent=1) if args.json else table(rows))


if __name__ == "__main__":
    main()
