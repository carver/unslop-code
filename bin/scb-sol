#!/usr/bin/env bash
# Subscription-only Sol benchmark wrapper. Does not use the Claude usage guard.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export SCB_ROOT="$here"
# SCBENCH_PROBLEMS_PATH passes through when a run sets it; unset, slop-code reads the cache.
export UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-$here/outputs/astra-setup/harness-venv}"
export UV_CACHE_DIR="${UV_CACHE_DIR:-$here/outputs/astra-setup/uv-cache}"
export DOCKER_HOST="${DOCKER_HOST:-unix:///tmp/unslop-docker.sock}"
export PATH="$here/outputs/astra-setup/tools-venv/bin:$PATH"
# Container commands outside evaluation run as HUID:HGID, root when unset, and a
# root-owned .venv in the workspace breaks host-side cleanup (see bin/scb).
export HUID="${HUID:-$(id -u)}"
export HGID="${HGID:-$(id -g)}"
unset OPENAI_API_KEY ANTHROPIC_API_KEY
python3 - <<'PY'
import json
from pathlib import Path
path = Path.home() / '.codex/auth.json'
if not path.is_file():
    raise SystemExit('scb-sol: Codex login required; no auth.json found')
auth = json.loads(path.read_text())
if auth.get('OPENAI_API_KEY') or not isinstance(auth.get('tokens'), dict):
    raise SystemExit('scb-sol: expected Codex subscription authentication')
PY
if [[ ! -x "$UV_PROJECT_ENVIRONMENT/bin/slop-code" ]]; then
  echo 'scb-sol: install the pinned harness first (see notes/astra-run.md)' >&2
  exit 2
fi
cp "$here/configs/models/gpt-5.6-sol.yaml" "$here/slop-code-bench/configs/models/gpt-5.6-sol.yaml"
exec "$UV_PROJECT_ENVIRONMENT/bin/slop-code" "$@"
