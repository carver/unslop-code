#!/usr/bin/env python3
"""The after-run ritual, mechanical part: a ledger row and a failure summary for one run.

    bin/ledger-row <run_dir>

Prints the table row for notes/<problem>-runs.md (scores per checkpoint, miss count, cost, and
the quality scores: the checkpoint mean notes/results.md shows, then the final checkpoint's
implementation files alone, as bin/quality-split scores them) and the failure-summary entry:
each missed hidden test under the checkpoint it belongs to, with the checkpoints it failed at,
then the same misses grouped by how they failed and the other runs that share each group
(bin/miss-signatures). The cause of each miss is the reader's to add; the evaluation output
(`<ckpt>/evaluation/stdout.txt`), `bin/miss-report`, and `bin/askrun` are where to look. Ends by running `bin/results --write`, so the cross-problem table in
notes/results.md always carries the run; commit it with the ledger. After a ladder run, also
extend the ladder section with `bin/compare-runs <runs...> --md`.
"""
import collections
import json
import pathlib
import subprocess
import sys
import types

HERE = pathlib.Path(__file__).resolve().parent
summarize = types.ModuleType("summarize")
summarize.__file__ = str(HERE / "summarize")
sys.modules["summarize"] = summarize
exec(compile((HERE / "summarize").read_text(), str(HERE / "summarize"), "exec"), summarize.__dict__)
sys.path.insert(0, str(HERE.parent / "report"))
import scb_split  # noqa: E402


def failures(problem_dir):
    """{(origin checkpoint, test): [run checkpoints it failed at]}"""
    out = collections.defaultdict(list)
    for ev in sorted(problem_dir.glob("checkpoint_*/evaluation.json"), key=lambda p: int(p.parent.name.split("_")[1])):
        at = int(ev.parent.name.split("_")[1])
        for group, res in json.loads(ev.read_text()).get("tests", {}).items():
            origin = int(group.split("-")[0].removeprefix("checkpoint_"))
            for t in res.get("failed") or []:
                out[(origin, t)].append(at)
    return out


def fmt(value, spec=".3f"):
    return "-" if value is None else format(value, spec)


def mean(values):
    values = [v for v in values if v is not None]
    return sum(values) / len(values) if values else None


def quality_clause(rows, split):
    """`rows` are the run's checkpoints, `split` is scb_split.split_reports of the final snapshot."""
    whole = ", ".join(f"{label} {fmt(mean(r.get(key) for r in rows))}" for label, key in
                      [("erosion", "erosion"), ("verbosity", "verbosity"), ("ast", "ast_grep_pct"),
                       ("cloned", "cloned_pct")])
    impl = scb_split.scores(split["impl"])
    share = scb_split.ratio(split["impl"]["total_loc"], split["impl"]["total_loc"] + split["test"]["total_loc"])
    return (f"Quality: {whole}; final checkpoint, implementation only ({fmt(share, '.0%')} of LOC): "
            f"ast {fmt(impl['ast'])}, erosion {fmt(impl['erosion'])}, cloned {fmt(impl['cloned'])}")


def main():
    run = pathlib.Path(sys.argv[1]).resolve()
    rows = summarize.load_rows(run)
    problem = rows[0]["problem"]
    scores = ", ".join(f"{r['passed_tests']}/{r['total_tests']}" for r in rows)
    strict = sum(r.get("strict_pass_rate", r.get("pass_rate")) == 1.0 for r in rows)
    cost = sum(r.get("cost") or 0 for r in rows)
    minutes = sum(summarize.elapsed(r) for r in rows) / 60
    fails = failures(run / problem)
    name = run.parent.name.removeprefix("opus-5_2.1.251_high_")
    quality = quality_clause(rows, scb_split.split_reports(run / problem / rows[-1]["checkpoint"] / "snapshot"))
    print(f"| {name} | `…{name}/{run.name}` | WHAT CHANGED | {scores} | complete {rows[-1].get('ended', '')[:10]}; "
          f"{len(fails)} misses (CAUSES); {strict}/{len(rows)} strict, ${cost:.0f}, {minutes:.0f} min. {quality} |")
    print()
    print(f"### {name}")
    print()
    print(
        f"{rows[-1]['passed_tests']}/{rows[-1]['total_tests']}, {strict}/{len(rows)} checkpoints strict, "
        f"${cost:.0f}, {minutes:.0f} min."
    )
    print()
    by_origin = collections.defaultdict(list)
    for (origin, t), at in sorted(fails.items()):
        by_origin[origin].append((t, at))
    for origin in sorted(by_origin):
        print(f"  - Checkpoint {origin}:")
        for t, at in by_origin[origin]:
            where = "" if at == list(range(origin, rows[-1]['idx'] + 1)) else f" (failed at {', '.join(map(str, at))})"
            print(f"      {t}{where}")
    if not fails:
        print("  - No misses.")
        return
    print()
    print("Misses by how they failed (bin/miss-signatures); a group other runs share is rarely the prompt's doing:")
    print()
    sys.stdout.flush()
    subprocess.run([str(HERE / "miss-signatures"), str(run), "--problem", problem], check=True)


def regenerate_results():
    """notes/results.md is generated from the run directories; a finished run belongs in it."""
    subprocess.run(
        [str(pathlib.Path(__file__).resolve().with_name("results")), "--write"], check=True, stdout=subprocess.DEVNULL
    )
    print("regenerated notes/results.md; commit it with the ledger", file=sys.stderr)


if __name__ == "__main__":
    main()
    regenerate_results()
