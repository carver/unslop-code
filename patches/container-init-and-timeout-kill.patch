+    def test_orphaned_children_are_reaped(
+        self, integration_spec: DockerEnvironmentSpec, tmp_path: Path
+    ) -> None:
+        """A finished orphan must not linger as a zombie that pgrep still sees."""
+        runtime = DockerStreamingRuntime.spawn(
+            environment=integration_spec,
+            working_dir=tmp_path,
+            disable_setup=True,
+        )
+        try:
+            list(runtime.stream("sh -c 'sleep 0.1 &'", env={}, timeout=30))
+            events = list(
+                runtime.stream(
+                    "sleep 1; grep -l '^State:.*Z' /proc/[0-9]*/status 2>/dev/null | wc -l",
+                    env={},
+                    timeout=30,
+                )
+            )
+            assert events[-1].result.stdout.strip() == "0"
+        finally:
+            runtime.cleanup()
+
+    def test_timeout_kills_the_command_inside_the_container(
+        self, integration_spec: DockerEnvironmentSpec, tmp_path: Path
+    ) -> None:
+        """Killing the docker exec client alone leaves the command running."""
+        runtime = DockerStreamingRuntime.spawn(
+            environment=integration_spec,
+            working_dir=tmp_path,
+            disable_setup=True,
+        )
+        try:
+            started = time.monotonic()
