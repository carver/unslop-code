#!/usr/bin/env python3
"""The uplift grid: two prompts by two specs, per problem and averaged across problems.

    bin/grid [--json] [--prompts A,B] [--model opus-5] [--set dev|test|all]

Rows are problems; the four cells are (prompt, spec) with spec v0 (the cached benchmark
spec) and "patched", the highest spec version that BOTH prompts have a complete run on, so
the two prompts are always compared on the same words. Every figure is one where lower is
better: fail% is the share of hidden tests failed at the last checkpoint (1 - score), the
four quality means are as bin/results reports them, cost is cc_$ per run, minutes the run's
wall clock (checkpoint end minus start, summed). A cell lists its
runs and their mean; the bottom rows average the cell means over the problems that have the
cell (n says how many). --json prints the same structure for a page to draw from.

Problems default to the dev set of split.json, the six the experiment ran in full; --set test
takes the test set as its runs land, --set all every problem with a run.

Prompts default to the benchmark's just-solve and min12-ABDJKMN, the pair the 2x2 uplift
experiment compares (notes/uplift-grid.md). Runs are read the way bin/results reads them.

The JSON also carries "trajectory": erosion per progress phase for each prompt's v0 runs, the
paper's five-phase view of a run (Start, Early, Mid, Late, Final) so the page can lay the two
prompts over Figure 5 of arXiv 2603.24755v2.

And "relative": for erosion and ast-grep, the second prompt's v0 value as a share of the first
prompt's, problem by problem, then the mean of those shares with the best and worst problem
named. The human reference gets the same treatment, so the two compare: its mean, its lowest
and highest repository and its quartiles, all as shares. The human figures come from
report/human-split.json, the paper's Major-tier repositories rescored by bin/quality-split.

--json adds "impl": the same grid with erosion, ast% and cloned% rescored on implementation
files only (report/scb_split.py, two scb-check runs per checkpoint, cached), and the human
reference taken from the repositories' implementation files, so a page can switch scope.
"""
import json
import pathlib
import statistics
import sys
import types

HERE = pathlib.Path(__file__).resolve().parent
SPLIT = HERE.parent / "split.json"
results = types.ModuleType("results")
results.__file__ = str(HERE / "results")
sys.modules["results"] = results
exec(compile((HERE / "results").read_text(), str(HERE / "results"), "exec"), results.__dict__)
sys.path.insert(0, str(HERE.parent / "report"))
import scb_split  # noqa: E402

METRICS = ("fail", "erosion", "verbosity", "ast", "cloned", "cost", "minutes")
DEFAULT_PROMPTS = ("just-solve", "min12-ABDJKMN")
PHASES = ("Start", "Early", "Mid", "Late", "Final")
# The human reference: the Major tier (over 10k stars) of the panel in arXiv 2603.24755v1,
# Table 7, rescored at HEAD by bin/quality-split --tree with the scb-check version the runs
# use (notes/quality-test-dilution.md). The paper's own table gives erosion 0.31, which the
# rerun matches, and ast-grep 0.10, which it does not (0.063): another rule set, so the
# paper's figure cannot sit beside ours. Its clone figure is 0.07 against the rerun's 0.10.
HUMAN_SPLIT = HERE.parent / "report" / "human-split.json"
HUMAN_METRICS = ("erosion", "ast", "cloned")
TRAJECTORY_METRICS = ("erosion", "verbosity", "ast", "cloned")


def run_figures(run):
    """A run's row of the grid: fail% and the quality means, all lower-is-better."""
    return {"fail": 1 - run["score"], "erosion": run["erosion"], "verbosity": run["verbosity"],
            "ast": run["ast"], "cloned": run["cloned"], "cost": run["cost"], "minutes": run["minutes"]}


def problem_set(name):
    """The problems of split.json's dev or test list, or None for "all"."""
    return None if name == "all" else set(json.loads(SPLIT.read_text())[name])


def only(cells, problems):
    return cells if problems is None else {key: runs for key, runs in cells.items() if key[0] in problems}


def spec_number(spec):
    return int(spec.removeprefix("v"))


def patched_spec(cells, problem, prompts, model):
    """The highest spec version every prompt has a complete run on, or None."""
    versions = None
    for prompt in prompts:
        have = {spec for (p, pr, spec, m) in cells if p == problem and pr == prompt and m == model and spec != "v0"}
        versions = have if versions is None else versions & have
    return max(versions, key=spec_number) if versions else None


def phase_of(idx, count):
    """Which of PHASES checkpoint idx (0-based) of a count-checkpoint run falls in.

    The paper's rule (arXiv 2603.24755v2, section 3): the first checkpoint is Start, the last is
    Final, and the interior ones split into Early, Mid and Late. It does not say how an interior
    that is not a multiple of three splits; here each interior checkpoint goes by the third its
    centre falls in, so two interior checkpoints are Early and Late, four are Early, Mid, Mid, Late."""
    if idx == 0:
        return 0
    if idx == count - 1:
        return len(PHASES) - 1
    return 1 + int(3 * (idx - 0.5) / (count - 2))


def trajectory(cells, prompts=DEFAULT_PROMPTS, model="opus-5", spec="v0"):
    """{"spec": spec, "phases": [...], "prompts": {prompt: {"runs": k, "ckpts": [per phase],
    "erosion": [per phase], "verbosity": [...], "ast": [...], "cloned": [...]}}}: each prompt's
    checkpoints at that spec, pooled over its runs on every problem, meaned by phase. "ckpts"
    counts the checkpoints with an erosion score; a metric with no scores (verbosity on an
    implementation-only run) is null in every phase."""
    out = {"spec": spec, "phases": list(PHASES), "prompts": {}}
    for prompt in prompts:
        pools = {metric: [[] for _ in PHASES] for metric in TRAJECTORY_METRICS}
        runs = 0
        for (_, pr, sp, m), summaries in cells.items():
            if pr != prompt or sp != spec or m != model:
                continue
            for run in summaries:
                runs += 1
                count = len(run["erosion_by_ckpt"])
                for metric in TRAJECTORY_METRICS:
                    for idx, value in enumerate(run.get(f"{metric}_by_ckpt") or []):
                        if value is not None:
                            pools[metric][phase_of(idx, count)].append(value)
        out["prompts"][prompt] = {
            "runs": runs,
            "ckpts": [len(x) for x in pools["erosion"]],
            **{metric: [results.mean(x) for x in pools[metric]] for metric in TRAJECTORY_METRICS},
        }
    return out


def human_panel(repos, part):
    """{metric: {"n", "mean", "min": {"repo", "value"}, "max": {...}, "q1", "q3"}} over the
    repositories of a bin/quality-split --json listing; part is "all" (the whole repository,
    as the benchmark scores a snapshot) or "impl" (test files left out)."""
    out = {}
    for metric in HUMAN_METRICS:
        values = {r["name"]: r[part][metric] for r in repos if r[part][metric] is not None}
        low, high = min(values, key=values.get), max(values, key=values.get)
        q1, _, q3 = statistics.quantiles(values.values(), n=4, method="inclusive")
        out[metric] = {"n": len(values), "mean": results.mean(list(values.values())), "q1": q1, "q3": q3,
                       "min": {"repo": low, "value": values[low]}, "max": {"repo": high, "value": values[high]}}
    return out


def human_shares(panel, bases):
    """A human value's share is its mean over the problems of value / baseline, which is the
    value times the mean of 1 / baseline, so every figure of the panel scales the same way."""
    per_unit = results.mean([1 / base for base in bases])
    return {"n": panel["n"], "value": panel["mean"], "mean": panel["mean"] * per_unit,
            "min": panel["min"] | {"share": panel["min"]["value"] * per_unit},
            "max": panel["max"] | {"share": panel["max"]["value"] * per_unit},
            "q1": {"value": panel["q1"], "share": panel["q1"] * per_unit},
            "q3": {"value": panel["q3"], "share": panel["q3"] * per_unit}}


def relative(g, human=None):
    """{"spec": "v0", "baseline": first prompt, "metrics": {metric: {"n": k,
    "prompt": {"mean": share, "best": {"problem", "share"}, "worst": {...}},
    "human": human_shares(...)}}}: a share is a value over the first prompt's v0 cell
    mean on the same problem, and "mean" averages the shares, not the values. A problem counts
    when both prompts ran it at v0 and the baseline is above zero. human is a human_panel."""
    a, b = g["prompts"]
    out = {"spec": "v0", "baseline": a, "metrics": {}}
    for metric in HUMAN_METRICS:
        pairs = {}
        for problem, entry in g["problems"].items():
            base, other = entry["cells"].get(f"{a}|v0"), entry["cells"].get(f"{b}|v0")
            if base and other and base["mean"][metric] > 0:
                pairs[problem] = (base["mean"][metric], other["mean"][metric])
        if not pairs:
            continue
        share = {problem: other / base for problem, (base, other) in pairs.items()}
        best, worst = min(share, key=share.get), max(share, key=share.get)
        out["metrics"][metric] = {
            "n": len(pairs),
            "prompt": {
                "mean": results.mean(list(share.values())),
                "best": {"problem": best, "share": share[best]},
                "worst": {"problem": worst, "share": share[worst]},
            },
        }
        if human:
            out["metrics"][metric]["human"] = human_shares(human[metric], [base for base, _ in pairs.values()])
    return out


def cell_means(runs):
    return {k: results.mean([r[k] for r in runs]) for k in METRICS}


def impl_run(run, split=scb_split.split_reports):
    """The run's summary with erosion, verbosity, ast% and cloned% rescored on implementation files
    only, checkpoint by checkpoint, and meaned the way bin/results means the whole-snapshot scores."""
    by_ckpt = [scb_split.scores(split(snapshot)["impl"]) for snapshot in run["snapshots"]]
    return run | {**{f"{metric}_by_ckpt": [c[metric] for c in by_ckpt] for metric in TRAJECTORY_METRICS},
                  **{metric: results.mean([c[metric] for c in by_ckpt]) for metric in TRAJECTORY_METRICS}}


def impl_cells(cells, prompts=DEFAULT_PROMPTS, model="opus-5", split=scb_split.split_reports):
    """cells with every run the grid draws (v0 and the patched spec) rescored by impl_run.
    Rescoring runs scb-check twice per checkpoint, so nothing else is touched."""
    out = {}
    for (problem, prompt, spec, m), runs in cells.items():
        drawn = spec in ("v0", patched_spec(cells, problem, prompts, model))
        if prompt in prompts and m == model and drawn:
            out[(problem, prompt, spec, m)] = [impl_run(run, split) for run in runs]
    return out


def grid(cells, prompts=DEFAULT_PROMPTS, model="opus-5", human=None):
    """{"prompts": [...], "problems": {problem: {"patched": "vN" | None,
    "cells": {"prompt|v0": {...}, "prompt|patched": {...}}}},
    "means": {"prompt|v0": {"n": k, **means}, ...}} with every cell {"spec": "vN", "runs": [...], "mean": {...}}."""
    problems = sorted({p for (p, pr, spec, m) in cells if pr in prompts and m == model})
    out = {"prompts": list(prompts), "problems": {}, "means": {}}
    for problem in problems:
        patched = patched_spec(cells, problem, prompts, model)
        entry = {"patched": patched, "cells": {}}
        for prompt in prompts:
            for kind, spec in (("v0", "v0"), ("patched", patched)):
                runs = cells.get((problem, prompt, spec, model), []) if spec else []
                if runs:
                    figures = [run_figures(r) for r in runs]
                    entry["cells"][f"{prompt}|{kind}"] = {"spec": spec, "runs": figures, "mean": cell_means(figures)}
        out["problems"][problem] = entry
    for prompt in prompts:
        for kind in ("v0", "patched"):
            key = f"{prompt}|{kind}"
            means = [e["cells"][key]["mean"] for e in out["problems"].values() if key in e["cells"]]
            if means:
                out["means"][key] = {"n": len(means), **cell_means(means)}
    out["trajectory"] = trajectory(cells, prompts, model)
    out["relative"] = relative(out, human)
    return out


def pct(v):
    return "-" if v is None else f"{100 * v:.1f}%"


def cell_text(cell):
    if cell is None:
        return "-"
    m = cell["mean"]
    return (
        f"{pct(m['fail'])} / {m['erosion']:.2f} / {m['ast']:.2f} / "
        f"${m['cost']:.0f} / {m['minutes']:.0f}m ({len(cell['runs'])})"
    )


def table(g):
    """Markdown: one row per problem, cells 'fail% / erosion / ast% / $ / minutes (runs)', then the means."""
    a, b = g["prompts"]
    heads = [f"{a} v0", f"{b} v0", f"{b} patched", f"{a} patched"]
    keys = [f"{a}|v0", f"{b}|v0", f"{b}|patched", f"{a}|patched"]
    lines = ["| problem | patched | " + " | ".join(heads) + " |", "|---|---|" + "---|" * 4]
    for problem, e in g["problems"].items():
        lines.append(
            f"| {problem} | {e['patched'] or '-'} | " + " | ".join(cell_text(e["cells"].get(k)) for k in keys) + " |"
        )
    means = [g["means"].get(k) for k in keys]
    ns = {m["n"] for m in means if m}
    n = f"n={'/'.join(str(x) for x in sorted(ns))}"
    lines.append(
        f"| mean | {n} | "
        + " | ".join(
            "-"
            if m is None
            else f"{pct(m['fail'])} / {m['erosion']:.2f} / {m['ast']:.2f} / "
            f"${m['cost']:.0f} / {m['minutes']:.0f}m ({m['n']})"
            for m in means
        )
        + " |"
    )
    return "\n".join(lines)


def main():
    args = sys.argv[1:]
    as_json = "--json" in args
    prompts = DEFAULT_PROMPTS
    model = "opus-5"
    problems = "dev"
    if "--set" in args:
        problems = args[args.index("--set") + 1]
    if "--prompts" in args:
        prompts = tuple(args[args.index("--prompts") + 1].split(","))
    if "--model" in args:
        model = args[args.index("--model") + 1]
    cells, _ = results.collect(results.run_dirs())
    cells = only(cells, problem_set(problems))
    repos = json.loads(HUMAN_SPLIT.read_text())
    g = grid(cells, prompts, model, human_panel(repos, "all"))
    if as_json:
        g["impl"] = grid(impl_cells(cells, prompts, model), prompts, model, human_panel(repos, "impl"))
    print(json.dumps(g, indent=1) if as_json else table(g))


if __name__ == "__main__":
    main()
