+# ============================================================================
+# ProblemConfig.limit_checkpoints Tests
+# ============================================================================
+
+import pytest
+
+from slop_code.evaluation.config import ConfigError
+
+
+class TestProblemConfigLimitCheckpoints:
+    """Tests for ProblemConfig.limit_checkpoints."""
+
+    def _problem(self) -> ProblemConfig:
+        return ProblemConfig(
+            name="test",
+            path=Path("/test"),
+            version=1,
+            description="Test problem",
+            entry_file="main.py",
+            tags=["test"],
+            checkpoints={
+                name: CheckpointConfig(name=name, version=1, order=order)
+                for order, name in enumerate(
+                    ["checkpoint_1", "checkpoint_2", "checkpoint_3"], start=1
+                )
+            },
+        )
+
+    def test_drops_checkpoints_past_max_order(self):
+        limited = self._problem().limit_checkpoints(2)
+        assert [name for name, _ in limited.iterate_checkpoint_items()] == [
+            "checkpoint_1",
+            "checkpoint_2",
+        ]
+
+    def test_max_order_at_or_past_end_keeps_all(self):
+        problem = self._problem()
+        assert problem.limit_checkpoints(3) is problem
+        assert problem.limit_checkpoints(99) is problem
+
+    def test_raises_when_nothing_kept(self):
+        problem = self._problem()
+        with pytest.raises(ConfigError):
+            problem.limit_checkpoints(0)
+
+    def test_original_config_unchanged(self):
+        problem = self._problem()
+        problem.limit_checkpoints(1)
+        assert len(problem.checkpoints) == 3
