#!/usr/bin/env python3
"""Print subscription rate-limit utilization (what Claude Code's /usage shows).

Uses the live login access token in ~/.claude/.credentials.json. A `claude setup-token`
token cannot be used here: it only has inference scope and the usage endpoint answers 403.
Both tokens belong to the same account, so the numbers are the same. Never prints the token.
"""
import json
import pathlib
import urllib.request
import datetime

tok = json.loads(pathlib.Path("~/.claude/.credentials.json").expanduser().read_text())["claudeAiOauth"]["accessToken"]
req = urllib.request.Request(
    "https://api.anthropic.com/api/oauth/usage",
    headers={"Authorization": "Bearer " + tok, "anthropic-beta": "oauth-2025-04-20", "User-Agent": "claude-code/2.1.251"},
)
with urllib.request.urlopen(req, timeout=20) as r:
    d = json.load(r)
now = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
row = {"at": now}
for w in ("five_hour", "seven_day", "seven_day_sonnet"):
    v = d.get(w)
    row[w] = None if v is None else {"pct": v["utilization"], "resets_at": v["resets_at"]}
print(json.dumps(row))
