#!/usr/bin/env bash
# Run `slop-code` with subscription auth only.
#
# - Drops ANTHROPIC_API_KEY (and every other ANTHROPIC_* variable) from the environment.
# - Exports CLAUDE_CODE_OAUTH_TOKEN from a 0600 file written by `claude setup-token`.
# - Refuses to start if any Anthropic API key is still visible.
#
# Usage: bin/scb run --model claude_code_oauth/sonnet-4.6 ...
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
token_file="${SCB_OAUTH_TOKEN_FILE:-$HOME/.config/scbench/claude-oauth-token}"

if [[ ! -f "$token_file" ]]; then
  echo "scb: no subscription token at $token_file" >&2
  echo "scb: run 'claude setup-token' and save the printed token there (chmod 600)" >&2
  exit 2
fi
if [[ "$(stat -c %a "$token_file")" != "600" ]]; then
  echo "scb: $token_file must be mode 600" >&2
  exit 2
fi

for var in $(env | grep -i '^ANTHROPIC' | cut -d= -f1); do
  unset "$var"
done
if env | grep -qi 'sk-ant-api'; then
  echo "scb: an Anthropic API key is still in the environment, refusing to run" >&2
  exit 2
fi

CLAUDE_CODE_OAUTH_TOKEN="$(tr -d '[:space:]' < "$token_file")"
export CLAUDE_CODE_OAUTH_TOKEN
case "$CLAUDE_CODE_OAUTH_TOKEN" in
  sk-ant-oat01-*) ;;
  *) echo "scb: token in $token_file does not look like a Claude OAuth token (sk-ant-oat01-...)" >&2; exit 2 ;;
esac

# Runs read the pinned, patched checkout at harness/ (built by install.py), not the
# development clone at slop-code-bench/: a branch switch there dropped the source patches
# under a running queue on 2026-09-11. The venv is sandbox-local, outside the host-mounted
# tree: a `uv run` on the host rebuilds a mounted .venv for the host's Python, which wiped
# one under a running sandbox worker on 2026-08-30.
export UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-$HOME/.venvs/scbench-harness}"

# Container commands outside evaluation (notably the env's resume_commands) run as
# get_actual_user(), which falls back to root when HUID/HGID are unset. A root-owned
# .venv in the mounted temp workspace then breaks host-side cleanup and marks the
# problem failed after its artifacts were already saved (seen 2026-08-31 on a
# --resume). The agent itself already runs as 1000:1000; make everything match.
export HUID="${HUID:-$(id -u)}"
export HGID="${HGID:-$(id -g)}"
# The harness appends this to the run's harness_provenance.jsonl at every start and resume.
SCB_HARNESS_PROVENANCE="$(python3 "$here/bin/harness-provenance" "$@")"
export SCB_HARNESS_PROVENANCE
exec uv run --project "$here/harness" slop-code "$@"
