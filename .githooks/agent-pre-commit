#!/usr/bin/env bash
# The checks CI runs that are too slow for pre-commit, run before every agent commit by
# agent-commit-gate (llm-toolbox), which blocks the commit when this fails. Humans can run it
# by hand. Tests the working tree, not only the staged files, like pre-commit.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
python3 -m pytest -q -x
