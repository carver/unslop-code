#!/usr/bin/env python3
"""Extend a run that stopped early: resume it one checkpoint at a time, between 5-hour windows.

Usage: bin/scb-extend <run_dir> <problem> <n_checkpoints>

Each checkpoint is its own `scb run --resume --stop-after-checkpoint N`, so a halt lands
between checkpoints and never inside one. Before each checkpoint the 5-hour window is read
(bin/usage); if the checkpoint might not fit before the reset, sleep through the reset
rather than have the agent die rate-limited mid-checkpoint. The reading before and after
every checkpoint is appended to <run_dir>/<problem>/window_usage.jsonl, so the window cost
of a checkpoint is measured, and the reserve kept for the next one is 1.25x the largest
measured cost (default 30 points until one is measured).

Unlike bin/scb-strict, a failing test does not halt; these runs are expected to miss.
Only a missing evaluation, an infrastructure failure, or scb itself failing halts.

Before each resume, run_info.yaml is checked against the checkpoint directories. A resume
that ends in an error rewrites run_info.yaml with every checkpoint it did not itself run
marked "skipped", and the next resume trusts that file and deletes those directories
(this destroyed v4's checkpoints 1 and 2 on 2026-09-02). A finished checkpoint whose
state is not "ran" is set back to "ran", with the old file kept as run_info.yaml.bak-<ts>.
Then `scb run --resume --dry-run` previews the resume, and the driver halts (exit 5) if the
preview would delete a finished checkpoint, whatever the reason.
Progress lines start with EXTEND: so a log watcher can filter on them.
Exit codes: 0 all checkpoints ran   3 checkpoint left no usable evaluation   4 scb failed
             5 the resume preview would delete a finished checkpoint
"""
import datetime, json, pathlib, shutil, subprocess, sys, time

import yaml

HERE = pathlib.Path(__file__).resolve().parent
DEFAULT_RESERVE = 30.0
RESET_SLACK_S = 90


def next_checkpoint(problem_dir, total):
    for n in range(1, total + 1):
        if not (problem_dir / f"checkpoint_{n}" / "evaluation.json").exists():
            return n
    return None


def finished(problem_dir, n):
    d = problem_dir / f"checkpoint_{n}"
    return all((d / f).exists() for f in ("evaluation.json", "inference_result.json", "snapshot"))


def repair_run_info(problem_dir, total, now=None):
    """Return the finished checkpoints whose run_info state was not 'ran', after fixing them."""
    path = problem_dir / "run_info.yaml"
    if not path.exists():
        return []
    info = yaml.safe_load(path.read_text()) or {}
    states = info.setdefault("summary", {}).setdefault("checkpoints", {}) or {}
    wrong = [f"checkpoint_{n}" for n in range(1, total + 1) if finished(problem_dir, n) and states.get(f"checkpoint_{n}") != "ran"]
    if wrong:
        now = now or datetime.datetime.now(datetime.timezone.utc)
        shutil.copy2(path, path.with_name(f"run_info.yaml.bak-{now:%Y%m%dT%H%M%S}"))
        for name in wrong:
            states[name] = "ran"
        info["summary"]["checkpoints"] = states
        path.write_text(yaml.safe_dump(info, sort_keys=False))
    return wrong


def deletions(dry_run_output):
    """Checkpoint directories a `--resume --dry-run` preview says it would delete."""
    paths = []; listing = False
    for line in dry_run_output.splitlines():
        if line.strip() == "Directories to delete:":
            listing = True
        elif listing and line.strip().startswith("- "):
            paths.append(pathlib.Path(line.strip()[2:]))
        elif listing and line.strip():
            listing = False
    return paths


def finished_dir(path):
    return all((path / f).exists() for f in ("evaluation.json", "inference_result.json", "snapshot"))


def outcome(problem_dir, n):
    ev = problem_dir / f"checkpoint_{n}" / "evaluation.json"
    if not ev.exists():
        return None
    d = json.loads(ev.read_text())
    return sum(d["pass_counts"].values()), sum(d["total_counts"].values()), bool(d.get("infrastructure_failure"))


def window_costs(records):
    """Points of the 5-hour window each finished checkpoint used, from before/after readings in the same window."""
    before = {}
    costs = []
    for r in records:
        key = (r["checkpoint"], r["five_hour"]["resets_at"])
        if r["phase"] == "before":
            before[key] = r["five_hour"]["pct"]
        elif key in before:
            costs.append(r["five_hour"]["pct"] - before[key])
    return [c for c in costs if c > 0]


def reserve(records):
    costs = window_costs(records)
    return max(costs) * 1.25 if costs else DEFAULT_RESERVE


def seconds_until_room(reading, needed, now):
    w = reading["five_hour"]
    if w["pct"] + needed <= 100:
        return 0
    resets = datetime.datetime.fromisoformat(w["resets_at"])
    return max(0, (resets - now).total_seconds()) + RESET_SLACK_S


def usage():
    return json.loads(subprocess.run([HERE / "usage"], check=True, capture_output=True, text=True).stdout)


def say(msg):
    print(f"EXTEND: {msg} {datetime.datetime.now(datetime.timezone.utc):%H:%M:%SZ}", flush=True)


def main():
    run_dir = pathlib.Path(sys.argv[1]).resolve(); problem = sys.argv[2]; total = int(sys.argv[3])
    problem_dir = run_dir / problem
    log = problem_dir / "window_usage.jsonl"
    records = [json.loads(l) for l in log.read_text().splitlines() if l.strip()] if log.exists() else []

    def record(n, phase):
        r = {"checkpoint": n, "phase": phase, **usage()}
        records.append(r)
        with log.open("a") as f:
            f.write(json.dumps(r) + "\n")
        return r

    while (n := next_checkpoint(problem_dir, total)) is not None:
        for name in repair_run_info(problem_dir, total):
            say(f"run_info.yaml had finished {name} marked not-ran; set to ran so resume keeps it")
        reading = record(n, "before")
        wait = seconds_until_room(reading, reserve(records), datetime.datetime.now(datetime.timezone.utc))
        if wait:
            say(f"window at {reading['five_hour']['pct']}% with {reserve(records):.0f} needed; sleeping {wait/60:.0f} min until reset")
            time.sleep(wait)
            reading = record(n, "before")
        resume = [HERE / "scb", "run", "--resume", str(run_dir), "--no-live-progress", "--stop-after-checkpoint", str(n)]
        preview = subprocess.run(resume + ["--dry-run"], capture_output=True, text=True)
        doomed = [d for d in deletions(preview.stdout) if finished_dir(d)]
        if preview.returncode != 0 or doomed:
            say(f"resume preview would delete finished {[d.name for d in doomed]} (exit {preview.returncode}); halting")
            print(preview.stdout[-2000:], preview.stderr[-1000:], sep="\n", flush=True)
            sys.exit(5)
        say(f"starting checkpoint_{n} (window {reading['five_hour']['pct']}%)")
        proc = subprocess.run(resume)
        after = record(n, "after")
        if proc.returncode != 0:
            say(f"scb exited {proc.returncode} on checkpoint_{n}")
        res = outcome(problem_dir, n)
        if res is None:
            say(f"checkpoint_{n} left no evaluation; halting (run_dir={run_dir})"); sys.exit(3)
        passed, tests, infra = res
        say(f"checkpoint_{n} {passed}/{tests} infra_fail={infra} window {reading['five_hour']['pct']}% -> {after['five_hour']['pct']}%")
        if infra:
            say(f"checkpoint_{n} infrastructure failure; halting (run_dir={run_dir})"); sys.exit(3)
        if proc.returncode != 0:
            sys.exit(4)
    say(f"DONE, {total} checkpoints present (run_dir={run_dir})")


if __name__ == "__main__":
    main()
