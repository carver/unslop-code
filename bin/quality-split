#!/usr/bin/env python3
"""Quality scores of implementation files against test files, per problem and prompt.

    bin/quality-split [--json] [--prompts A,B] [--model opus-5] [--set dev|test|all]
                      [--problem NAME ...] [--checkpoint N]
    bin/quality-split [--json] --tree DIR [--tree DIR ...]

scb-check scores every Python file in a snapshot, tests included, so a prompt that writes
more tests moves its scores without touching its implementation. For the final checkpoint of
each v0 run this copies the implementation files and the test files (named `test*`,
`*_test.py`, `conftest.py`, or under `tests/` or `testing/`) into two trees and runs the
pinned scb-check on each, and on the whole snapshot. --checkpoint N takes checkpoint N of the
runs that reached it, and --problem narrows the --set to the problems named. A cell pools its runs: ast% and cloned%
are flagged lines over LOC, erosion is high-complexity mass over total mass. --tree does the
same for any directory, such as a checkout of a human-written repository.
Reports are cached under outputs/quality-hits/split/.
"""
import argparse
import json
import pathlib
import sys
import types

HERE = pathlib.Path(__file__).resolve().parent
ROOT = HERE.parent
results = types.ModuleType("results")
results.__file__ = str(HERE / "results")
sys.modules["results"] = results
exec(compile((HERE / "results").read_text(), str(HERE / "results"), "exec"), results.__dict__)
sys.path.insert(0, str(ROOT / "report"))
from scb_split import PARTS, SUMMED, part_report, ratio, scores, split_reports  # noqa: E402,F401  (tests reach these)

def pooled(runs):
    """One row from a cell's runs: per part, LOC and the three scores over the summed counts."""
    row = {"runs": len(runs)}
    for part in PARTS:
        total = {k: sum(r[part][k] for r in runs) for k in SUMMED}
        row[part] = {"loc": total["total_loc"], "ast_lines": total["ast_grep_flagged_loc"], **scores(total)}
    row["test_share"] = ratio(row["test"]["loc"], row["impl"]["loc"] + row["test"]["loc"])
    return row


def scored_checkpoint(problem_dir, number=None):
    """The run's checkpoint `number` if it was scored, the last scored one when no number is given."""
    scored = {int(c.name.rsplit("_", 1)[1]): c for c in problem_dir.glob("checkpoint_*")
              if (c / "quality_analysis" / "scb_check.json").exists()}
    return scored.get(max(scored, default=None) if number is None else number)


def final_snapshots(prompts, model, problems, runs=None, checkpoint=None):
    """(problem, prompt, run, snapshot) for the final scored checkpoint of every v0 run of `prompts`
    by `model`, or for checkpoint number `checkpoint` of the runs that reached it; `problems` of
    None means all of them."""
    for run in results.run_dirs() if runs is None else runs:
        prompt, spec, run_model = results.cell_key(run)
        if prompt not in prompts or spec != "v0" or run_model != model:
            continue
        for problem_dir in sorted(d for d in run.iterdir() if d.is_dir() and (problems is None or d.name in problems)):
            chosen = scored_checkpoint(problem_dir, checkpoint)
            if chosen:
                yield problem_dir.name, prompt, run, chosen / "snapshot"


def collect(prompts, model, problems, checkpoint=None):
    cells = {}
    for problem, prompt, _, snapshot in final_snapshots(prompts, model, problems, checkpoint=checkpoint):
        cells.setdefault((problem, prompt), []).append(split_reports(snapshot))
    return cells


def rows_for_runs(prompts, model, problems, checkpoint=None):
    cells = collect(prompts, model, problems, checkpoint)
    rows = []
    for prompt in prompts:
        by_problem = {problem: runs for (problem, p), runs in sorted(cells.items()) if p == prompt}
        everything = [run for runs in by_problem.values() for run in runs]
        rows += [{"name": problem, "prompt": prompt, **pooled(cell)}
                 for problem, cell in [*by_problem.items(), ("ALL", everything)] if cell]
    return rows


def fmt(share, spec=".3f"):
    return "-" if share is None else format(share, spec)


def table(rows):
    lines = ["| name | prompt | runs | impl LOC | test LOC | test share | ast impl / test / all "
             "| erosion impl / test / all | cloned impl / test / all |", "|---|---|---|---|---|---|---|---|---|"]
    for row in rows:
        triples = (" / ".join(fmt(row[part][score]) for part in PARTS) for score in ("ast", "erosion", "cloned"))
        scores = " | ".join(triples)
        lines.append(f"| {row['name']} | {row.get('prompt', '-')} | {row['runs']} | {row['impl']['loc']} | "
                     f"{row['test']['loc']} | {fmt(row['test_share'], '.0%')} | {scores} |")
    return "\n".join(lines)


def chosen_problems(args):
    """The problems --problem names, else the --set's; None for every problem."""
    if args.problem:
        return set(args.problem)
    return None if args.set == "all" else set(json.loads((ROOT / "split.json").read_text())[args.set])


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--prompts", default="just-solve,min12-ABDJKMN")
    parser.add_argument("--model", default="opus-5")
    parser.add_argument("--set", default="dev", choices=["dev", "test", "all"])
    parser.add_argument("--problem", action="append")
    parser.add_argument("--checkpoint", type=int)
    parser.add_argument("--tree", action="append", type=pathlib.Path, default=[])
    args = parser.parse_args()
    if args.tree:
        rows = [{"name": tree.name, **pooled([split_reports(tree)])} for tree in args.tree]
    else:
        rows = rows_for_runs(args.prompts.split(","), args.model, chosen_problems(args), args.checkpoint)
    print(json.dumps(rows, indent=1) if args.json else table(rows))


if __name__ == "__main__":
    main()
