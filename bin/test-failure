#!/usr/bin/env python3
"""What pytest printed for one failing test of a run: its assertion (E) lines, per checkpoint.
    bin/test-failure <run> <substring-of-test-title> [--lines N] [--width N] [--full]
<run> is a run folder (outputs/<group>/<family>/<stamp>) or one problem inside it. Reads each
checkpoint_N/evaluation/stdout.txt and matches the needle against the titles in pytest's FAILURES
and ERRORS blocks, e.g. `TestErrors.test_missing_vault_route` or `test_cases[errors/alias_cycle]`.
Later checkpoints rerun earlier tests; a failure that prints the same lines again is shown once,
with the checkpoints that repeat it named. --full prints the whole section (traceback, captured
output) instead of the E lines.
"""
import argparse
import pathlib
import re

BANNER = re.compile(r"^=+ (.+) =+$")
TITLE = re.compile(r"^_+ (.+) _+$")
FAILURE_BLOCKS = {"FAILURES", "ERRORS"}
# What changes between two runs of one failing test without the failure changing.
PER_RUN = re.compile(r"(?<=:)\d{4,5}\b|0x[0-9a-f]+|(?<=pytest-)\d+")


def failure_sections(text):
    """[(title, body lines)] for every titled section inside pytest's FAILURES and ERRORS blocks."""
    sections = []
    in_block = False
    for line in text.splitlines():
        if banner := BANNER.match(line):
            in_block = banner.group(1) in FAILURE_BLOCKS
        elif not in_block:
            continue
        elif title := TITLE.match(line):
            sections.append((title.group(1), []))
        elif sections:
            sections[-1][1].append(line)
    return sections


def checkpoint_order(stdout):
    """Sort key of a checkpoint's stdout.txt: problem, then checkpoint number (10 after 9)."""
    checkpoint = stdout.parent.parent
    number = checkpoint.name.rpartition("_")[2]
    return checkpoint.parent.name, int(number) if number.isdigit() else -1, checkpoint.name


def run_failures(run):
    """[(problem, checkpoint, title, body lines)] over every checkpoint of the run, in order."""
    pattern = "checkpoint_*/evaluation/stdout.txt"
    stdouts = list(run.glob(pattern)) or list(run.glob(f"*/{pattern}"))
    if not stdouts:
        raise SystemExit(f"test-failure: no checkpoint_*/evaluation/stdout.txt under {run}")
    failures = []
    for stdout in sorted(stdouts, key=checkpoint_order):
        checkpoint = stdout.parent.parent
        for title, body in failure_sections(stdout.read_text(errors="replace")):
            failures.append((checkpoint.parent.name, checkpoint.name, title, body))
    return failures


def folded(failures):
    """[(problem, first checkpoint, title, lines, checkpoints that repeat it)]: a failure printing the
    same lines at a later checkpoint joins its first showing. Ports, object addresses and pytest's
    numbered tmp folders do not make lines differ."""
    first = {}
    for problem, checkpoint, title, lines in failures:
        key = (problem, title, tuple(PER_RUN.sub("#", line) for line in lines))
        if key in first:
            first[key][4].append(checkpoint)
        else:
            first[key] = (problem, checkpoint, title, lines, [])
    return list(first.values())


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("run", type=pathlib.Path, help="run folder, or one problem folder inside it")
    parser.add_argument("needle", help="substring of the failure's title, e.g. missing_vault")
    parser.add_argument("--lines", type=int, default=6, help="E lines per failure (default 6)")
    parser.add_argument("--width", type=int, default=240, help="cut each line here (default 240)")
    parser.add_argument("--full", action="store_true", help="the whole section, not only its E lines")
    args = parser.parse_args(argv)
    failures = run_failures(args.run)
    matches = [failure for failure in failures if args.needle in failure[2]]
    if not matches:
        titles = sorted({title for _, _, title, _ in failures})
        listing = "".join(f"\n  {title}" for title in titles) or " none"
        raise SystemExit(f"test-failure: no failure matching {args.needle!r}; the run's failures:{listing}")
    def shown(body):
        return body if args.full else [line for line in body if line.startswith("E  ")][: args.lines]

    matches = [(problem, checkpoint, title, shown(body)) for problem, checkpoint, title, body in matches]
    for problem, checkpoint, title, lines, repeats in folded(matches):
        again = f" (the same at {', '.join(repeats)})" if repeats else ""
        print(f"{problem}/{checkpoint} {title}{again}")
        for line in lines:
            print(line[: args.width])


if __name__ == "__main__":
    main()
