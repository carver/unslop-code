#!/usr/bin/env python3
"""Summarize a slop-code run directory: per-checkpoint solves, tokens, quality, list-price cost.

Usage: bin/summarize <run_dir> [--md]
Reads <run_dir>/checkpoint_results.jsonl (written by `slop-code eval` / `metrics static`).
"""
import json, sys, pathlib, collections

PRICE = {"input": 3.0, "output": 15.0, "cache_read": 0.30, "cache_write": 3.75}  # $/M, Sonnet 4.6 list

def cost(r):
    return sum(PRICE[k] * (r.get(k) or 0) / 1e6 for k in PRICE)

def main():
    run = pathlib.Path(sys.argv[1]); md = "--md" in sys.argv
    rows = [json.loads(l) for l in (run / "checkpoint_results.jsonl").read_text().splitlines() if l.strip()]
    rows.sort(key=lambda r: (r["problem"], r["idx"]))
    hdr = ["problem", "ckpt", "state", "strict", "iso", "core", "core_pr", "steps", "in", "out", "cache_r", "cache_w", "est_$", "elapsed_s", "erosion", "verbosity", "cloned%"]
    out = []
    tot = collections.Counter(); n = 0; sol = collections.Counter(); er = []; vb = []; cl = []
    for r in rows:
        c = cost(r); n += 1
        s = r.get("pass_rate") == 1.0; i = r.get("checkpoint_pass_rate") == 1.0; k = r.get("core_pass_rate") == 1.0
        sol["strict"] += s; sol["iso"] += i; sol["core"] += k
        for kk in PRICE: tot[kk] += r.get(kk) or 0
        tot["cost"] += c; tot["elapsed"] += r.get("elapsed") or 0; tot["steps"] += r.get("steps") or 0
        if r.get("erosion") is not None: er.append(r["erosion"])
        if r.get("verbosity") is not None: vb.append(r["verbosity"])
        if r.get("cloned_pct") is not None: cl.append(r["cloned_pct"])
        out.append([r["problem"], r["idx"], r.get("state"), "Y" if s else "n", "Y" if i else "n", "Y" if k else "n",
                    f"{(r.get('core_pass_rate') or 0):.2f}", r.get("steps"), r.get("input"), r.get("output"), r.get("cache_read"), r.get("cache_write"),
                    f"{c:.2f}", f"{(r.get('elapsed') or 0):.0f}", fmt(r.get("erosion")), fmt(r.get("verbosity")), fmt(r.get("cloned_pct"))])
    sep = " | " if md else "  "
    print(sep.join(hdr));
    if md: print("|".join(["---"] * len(hdr)))
    for o in out: print(sep.join(str(x) for x in o))
    print()
    print(f"checkpoints: {n}  strict {sol['strict']}/{n} = {100*sol['strict']/n:.2f}%  iso {sol['iso']}/{n} = {100*sol['iso']/n:.2f}%  core {sol['core']}/{n} = {100*sol['core']/n:.2f}%")
    print(f"tokens: in {tot['input']:,} out {tot['output']:,} cache_read {tot['cache_read']:,} cache_write {tot['cache_write']:,}")
    print(f"est list-price cost: ${tot['cost']:.2f} total, ${tot['cost']/n:.2f}/ckpt   (leaderboard target $1.96/ckpt)")
    print(f"wall time: {tot['elapsed']/60:.1f} min total, {tot['elapsed']/n/60:.1f} min/ckpt; steps/ckpt {tot['steps']/n:.1f}")
    mean = lambda xs: sum(xs) / len(xs) if xs else float("nan")
    print(f"erosion mean {mean(er):.3f} (target 0.741)  verbosity mean {mean(vb):.3f} (target 0.316)  cloned mean {mean(cl):.3f} (target 0.093)")

def fmt(v):
    return "-" if v is None else f"{v:.3f}"

main()
