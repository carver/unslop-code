#!/usr/bin/env python3
"""Summarize a slop-code run directory: per-checkpoint solves, tokens, quality, list-price cost.

Usage: bin/summarize <run_dir> [--md]
Reads <run_dir>/checkpoint_results.jsonl (written by `slop-code eval` / `metrics static`).
The quality columns come from a per-checkpoint scb-check report; a missing report is
computed from the checkpoint snapshot on first use and cached next to it, since
`slop-code metrics static` only keeps those scores in the aggregated result.json.
"""
import json
import os
import re
import sys
import pathlib
import collections
import datetime
import subprocess

PRICE = {"input": 3.0, "output": 15.0, "cache_read": 0.30, "cache_write": 3.75}  # $/M, Sonnet 4.6 list
# Leaderboard row for Sonnet 4.6 / Claude Code 2.1.44 / thinking high, means over all 196
# holdout checkpoints (notes/leaderboard-reference.md). A per-problem run is not comparable.
LEADERBOARD = {"erosion": 0.741, "verbosity": 0.316, "ast-grep": 0.298, "cloned": 0.093}

# Run families are named <model>_<agent version>_<effort>_<prompt>. Most runs are Opus 5 on Claude
# Code 2.1.251 at high, so labels drop that prefix; any other run keeps its model in front.
BASELINE_PREFIX = "opus-5_2.1.251_high_"
RUN_PREFIX = re.compile(r"^([^_]+)_[^_]+_(?:low|medium|high|xhigh|max|ultra)_")


def run_family(run_dir):
    """'opus-5_2.1.251_high_min13-ABDJKMNT' -> 'min13-ABDJKMNT';
    'opus-5-5_2.1.280_high_min13-ABDJKMNT-specv2' -> 'opus-5-5 min13-ABDJKMNT-specv2'."""
    family = pathlib.Path(run_dir).parent.name
    if family.startswith(BASELINE_PREFIX):
        return family.removeprefix(BASELINE_PREFIX)
    return RUN_PREFIX.sub(r"\1 ", family, count=1)


def run_label(run_dir):
    return f"{run_family(run_dir)}/{pathlib.Path(run_dir).name}"


def cost(r):
    return sum(PRICE[k] * (r.get(k) or 0) / 1e6 for k in PRICE)


def elapsed(r):
    if r.get("elapsed") is not None:
        return r["elapsed"]
    try:
        return (
            datetime.datetime.fromisoformat(r["ended"]) - datetime.datetime.fromisoformat(r["started"])
        ).total_seconds()
    except (KeyError, TypeError, ValueError):
        return 0.0


def quality_report(ckpt):
    report = ckpt / "quality_analysis" / "scb_check.json"
    try:
        return json.loads(report.read_text())
    except (OSError, ValueError):
        pass
    snapshot = ckpt / "snapshot"
    if not snapshot.is_dir():
        return None
    version = os.environ.get("SCB_CHECK_VERSION", "0.1.3")
    try:
        proc = subprocess.run(
            ["uvx", f"scb-check=={version}", "check", "--report", "--include-all", str(snapshot)],
            capture_output=True,
            text=True,
        )
    except OSError as exc:
        print(
            f"Cannot run scb-check on {ckpt}: {exc}. Ensure uvx is installed and on PATH; using existing metrics.",
            file=sys.stderr,
        )
        return None
    if proc.returncode != 0:
        print(f"scb-check failed on {ckpt}: {proc.stderr.strip()[-300:]}", file=sys.stderr)
        return None
    report.parent.mkdir(exist_ok=True)
    report.write_text(proc.stdout)
    return json.loads(proc.stdout)


def load_rows(run):
    """Checkpoint rows of a run, sorted, with the four quality scores from each checkpoint's scb-check report."""
    rows = [json.loads(line) for line in (run / "checkpoint_results.jsonl").read_text().splitlines() if line.strip()]
    for r in rows:
        d = quality_report(run / r["problem"] / r["checkpoint"])
        if d is not None:
            t = d.get("total_loc") or 0
            r["verbosity"] = d.get("verbosity")
            r["erosion"] = d.get("erosion")
            r["cloned_pct"] = (d.get("clone_loc") or 0) / t if t else None
            r["ast_grep_pct"] = (d.get("ast_grep_flagged_loc") or 0) / t if t else None
    rows.sort(key=lambda r: (r["problem"], r["idx"]))
    return rows


def main():
    run = pathlib.Path(sys.argv[1])
    md = "--md" in sys.argv
    rows = load_rows(run)
    hdr = [
        "problem",
        "ckpt",
        "state",
        "strict",
        "iso",
        "core",
        "core_pr",
        "steps",
        "in",
        "out",
        "cache_r",
        "cache_w",
        "cc_$",
        "list_$",
        "elapsed_s",
        "erosion",
        "verbosity",
        "ast%",
        "cloned%",
    ]
    out = []
    tot = collections.Counter()
    n = 0
    sol = collections.Counter()
    er = []
    vb = []
    cl = []
    ag = []
    for r in rows:
        c = cost(r)
        n += 1
        s = r.get("strict_pass_rate", r.get("pass_rate")) == 1.0
        i = r.get("isolated_pass_rate", r.get("checkpoint_pass_rate")) == 1.0
        k = r.get("core_pass_rate") == 1.0
        sol["strict"] += s
        sol["iso"] += i
        sol["core"] += k
        for kk in PRICE:
            tot[kk] += r.get(kk) or 0
        tot["cost"] += c
        tot["cc_cost"] += r.get("cost") or 0
        tot["elapsed"] += elapsed(r)
        tot["steps"] += r.get("steps") or 0
        if r.get("erosion") is not None:
            er.append(r["erosion"])
        if r.get("verbosity") is not None:
            vb.append(r["verbosity"])
        if r.get("cloned_pct") is not None:
            cl.append(r["cloned_pct"])
        if r.get("ast_grep_pct") is not None:
            ag.append(r["ast_grep_pct"])
        out.append(
            [
                r["problem"],
                r["idx"],
                r.get("state"),
                "Y" if s else "n",
                "Y" if i else "n",
                "Y" if k else "n",
                f"{(r.get('core_pass_rate') or 0):.2f}",
                r.get("steps"),
                r.get("input"),
                r.get("output"),
                r.get("cache_read"),
                r.get("cache_write"),
                f"{(r.get('cost') or 0):.2f}",
                f"{c:.2f}",
                f"{elapsed(r):.0f}",
                fmt(r.get("erosion")),
                fmt(r.get("verbosity")),
                fmt(r.get("ast_grep_pct")),
                fmt(r.get("cloned_pct")),
            ]
        )
    sep = " | " if md else "  "
    print(sep.join(hdr))
    if md:
        print("|".join(["---"] * len(hdr)))
    for o in out:
        print(sep.join(str(x) for x in o))
    print()
    print(
        f"checkpoints: {n}  strict {sol['strict']}/{n} = {100 * sol['strict'] / n:.2f}%  "
        f"iso {sol['iso']}/{n} = {100 * sol['iso'] / n:.2f}%  "
        f"core {sol['core']}/{n} = {100 * sol['core'] / n:.2f}%"
    )
    print(
        f"tokens: in {tot['input']:,} out {tot['output']:,} "
        f"cache_read {tot['cache_read']:,} cache_write {tot['cache_write']:,}"
    )
    print(
        f"cost as reported by Claude Code (cc_$): ${tot['cc_cost']:.2f} total, "
        f"${tot['cc_cost'] / n:.2f}/ckpt   (leaderboard $1.96/ckpt)"
    )
    print(
        f"cost at Sonnet list price from token counts (list_$): ${tot['cost']:.2f} total, ${tot['cost'] / n:.2f}/ckpt"
    )
    print(
        f"wall time: {tot['elapsed'] / 60:.1f} min total, {tot['elapsed'] / n / 60:.1f} min/ckpt; "
        f"steps/ckpt {tot['steps'] / n:.1f}"
    )

    def mean(xs):
        return sum(xs) / len(xs) if xs else float("nan")

    print(
        f"{'quality means':<22}erosion {mean(er):.3f}  verbosity {mean(vb):.3f}  "
        f"ast-grep {mean(ag):.3f}  cloned {mean(cl):.3f}"
    )
    print(
        f"{'sonnet 4.6 just-solve':<22}erosion {LEADERBOARD['erosion']:.3f}  verbosity {LEADERBOARD['verbosity']:.3f}  "
        f"ast-grep {LEADERBOARD['ast-grep']:.3f}  cloned {LEADERBOARD['cloned']:.3f}"
    )


def fmt(v):
    return "-" if v is None else f"{v:.3f}"


if __name__ == "__main__":
    main()
