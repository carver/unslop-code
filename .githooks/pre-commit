#!/usr/bin/env bash
# Agents' commits also run the slower agent-pre-commit (llm-toolbox agent-commit-gate).
if [ -n "${AI_AGENT:-}" ] && [ -z "${AGENT_PRE_COMMIT:-}" ]; then AGENT_PRE_COMMIT=1 "$(dirname "$0")/agent-pre-commit" || exit; fi
# Runs bin/lint before every commit. Installed by `python3 install.py`, which points
# core.hooksPath here; `git commit --no-verify` skips it. Lints the whole working tree,
# not only the staged files, so an unstaged lint error blocks the commit too.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
bin/lint
