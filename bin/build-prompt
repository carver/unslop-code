#!/usr/bin/env python3
"""Build a prompt from a chunk set: bin/build-prompt BEG -> configs/prompts/min4-BEG.jinja

Chunks live in configs/prompts/<set>-chunks/, one rule per file, named <letter>-<slug>.txt.
The default set is min4; --set min9 picks configs/prompts/min9-chunks/ and writes
min9-<LETTERS>.jinja. Letters are sorted, so the same set always builds the same file.

Two layouts. HEAD/TAIL (min4): the prompt is HEAD.jinja, the chosen chunks in letter order
separated by blank lines, and TAIL.jinja. SKELETON (min9): chunks are named
<letter>-<section>-<slug>.txt and SKELETON.jinja holds the fixed structure with one
<<section>> slot per section; each slot becomes that section's chosen chunks, and an
empty slot disappears with its trailing blank line, so section headers survive any subset.

    bin/build-prompt [--set NAME] LETTERS
    bin/build-prompt [--set NAME] --list      the chunk index
"""
import pathlib, re, sys

PROMPTS = pathlib.Path(__file__).resolve().parent.parent / "configs" / "prompts"
CHUNKS = PROMPTS / "min4-chunks"


def chunks_dir_for(set_name):
    return PROMPTS / f"{set_name}-chunks"


def section_of(path):
    """The section tag of a SKELETON-layout chunk, <letter>-<section>-<slug>.txt."""
    return path.stem.split("-")[1]


def index(chunks_dir=CHUNKS):
    """{letter: path} for every <letter>-<slug>.txt chunk."""
    out = {}
    for p in sorted(chunks_dir.glob("?-*.txt")):
        out[p.name[0]] = p
    return out


def build(letters, chunks_dir=CHUNKS):
    """(name, text) for a chunk set; unknown or repeated letters are an error."""
    idx = index(chunks_dir)
    chosen = sorted(set(letters.upper()))
    unknown = [letter for letter in chosen if letter not in idx]
    if unknown or len(chosen) != len(letters):
        raise SystemExit(f"build-prompt: chunks are {''.join(idx)}; got {letters!r}")
    name = chunks_dir.name.removesuffix("-chunks") + "-" + "".join(chosen)
    skeleton = chunks_dir / "SKELETON.jinja"
    if skeleton.exists():
        return name, fill_skeleton(skeleton.read_text(), [idx[letter] for letter in chosen])
    parts = [(chunks_dir / "HEAD.jinja").read_text().rstrip("\n")]
    parts += [idx[letter].read_text().rstrip("\n") for letter in chosen]
    parts.append((chunks_dir / "TAIL.jinja").read_text().rstrip("\n"))
    return name, "\n\n".join(parts) + "\n"


def fill_skeleton(text, chunks):
    """Each <<section>> slot becomes its chunks joined by blank lines; an empty slot vanishes."""
    for section in re.findall(r"<<(\w+)>>", text):
        body = "\n\n".join(c.read_text().rstrip("\n") for c in chunks if section_of(c) == section)
        text = text.replace(f"<<{section}>>\n\n", body + "\n\n" if body else "")
    return text


def main():
    args = sys.argv[1:]
    chunks_dir = CHUNKS
    if len(args) >= 2 and args[0] == "--set":
        chunks_dir = chunks_dir_for(args[1]); args = args[2:]
    if len(args) != 1:
        raise SystemExit(__doc__)
    if args[0] == "--list":
        for letter, p in index(chunks_dir).items():
            print(f"{letter}  {p.stem[2:]:<34} {p.read_text().splitlines()[0][:80]}")
        return
    name, text = build(args[0], chunks_dir)
    out = PROMPTS / f"{name}.jinja"
    out.write_text(text)
    print(out.relative_to(PROMPTS.parent.parent), f"{len(text.split())} words")


if __name__ == "__main__":
    main()
