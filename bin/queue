#!/usr/bin/env python3
"""The run queue: one benchmark run at a time, in order, surviving this shell and session.

    bin/queue add <run-config.yaml> [n_checkpoints]   enqueue `scb-extend --new` for the config
    bin/queue                                          status (pueue status)
    bin/queue log [id]                                 a job's output (pueue log)
    bin/queue resume <run_dir> [n] [--problem NAME]    continue a run that stopped between checkpoints
                                                       (scb-extend's resume mode; the run's problem and
                                                       checkpoint count are read from the run; a run
                                                       with several problems names one with --problem)
    bin/queue add --next <config.yaml> [n_checkpoints]  the same, but ahead of every queued job
                                                       (pueue priority one above the highest queued)
    bin/queue move <id> before <other-id>              reorder queued jobs so <id> runs right before
                                                       <other-id>; prints the resulting order
    bin/queue add-strict <run-config.yaml> [n_checkpoints]  enqueue `scb-strict` for the config: one
                                                       checkpoint per scb call, halting at the first
                                                       that is not a strict solve
    bin/queue resume-strict <run_dir> [n] [--problem NAME]  the same through bin/scb-strict: each later
                                                       checkpoint runs only if the one before was strict
    bin/queue solo <id>                                run one queued job while everything else waits:
                                                       stashes the other queued jobs, starts the group,
                                                       pauses it again with --wait, re-queues the stash.
                                                       (`pueue start <id>` resumes the whole group.)
    bin/queue kill <id> [--keep-paused]                stop a job and clean up after it: a queued job is
                                                       removed; a running one is killed, its surviving
                                                       worker processes and agent container removed,
                                                       and the queue resumed with the next job
    bin/queue <anything else>                          passed to pueue as-is

A config written by bin/run-config for a spec version carries SCBENCH_PROBLEMS_PATH in
its launch comment; `add` reads that, the problem from the config, and the checkpoint
count from the catalog. Jobs run through pueue (install.py installs it), whose default
group runs one task at a time, so the 5-hour window is drawn on by one run only.
"""
import json, os, pathlib, re, shlex, signal, subprocess, sys, time

import yaml

ROOT = pathlib.Path(__file__).resolve().parent.parent
PUEUE = pathlib.Path.home() / ".local" / "bin" / "pueue"


CACHE = pathlib.Path(os.environ.get("SCBENCH_PROBLEMS_PATH", os.path.expanduser("~/.cache/scbench/problems")))


def problems_root(config_text):
    """The problems root a config's launch line selects, or the cache when it selects none."""
    m = re.search(r"^#.*SCBENCH_PROBLEMS_PATH=(\S+)", config_text, re.M)
    return pathlib.Path(m.group(1).replace("$PWD", str(ROOT))) if m else CACHE


def run_problems_root(run_dir):
    """The problems root a finished or stopped run read, from the catalog record slop-code writes."""
    record = json.loads((run_dir / "problem_catalog.json").read_text())
    return pathlib.Path(record["commit"]) if record.get("version") == "env-override" else CACHE


def provider_env(config):
    """Codex subscription jobs use their launcher without Claude usage polling."""
    model = config.get("model", {})
    if not isinstance(model, dict) or model.get("provider") != "codex_auth":
        return {}
    launchers = {"gpt-5.6-sol": "scb-sol", "gpt-6-astra": "scb-astra"}
    if model.get("name") not in launchers:
        raise SystemExit(f"queue: no Codex launcher for {model.get('name')}")
    return {"SCB_LAUNCHER": str(ROOT / "bin" / launchers[model["name"]]),
            "SCB_USAGE_TRACKING": "0"}


def job_for(config_path, n=None):
    """(label, argv, env) to run one config through bin/scb-extend."""
    config_path = pathlib.Path(config_path).resolve()
    text = config_path.read_text()
    root = problems_root(text)
    config = yaml.safe_load(text)
    problems = config["problems"]
    if len(problems) != 1:
        raise SystemExit(f"queue: {config_path.name} lists {len(problems)} problems; one per run")
    problem = problems[0]
    n = n or len(list((root / problem).glob("checkpoint_*.md")))
    if not n:
        raise SystemExit(f"queue: no checkpoints found for {problem} under {root}; build it with bin/spec-patch or pass n_checkpoints")
    label = config_path.name.removesuffix(".yaml").removesuffix("-opus5")
    env = {} if root == CACHE else {"SCBENCH_PROBLEMS_PATH": str(root)}
    provider = provider_env(config)
    env.update(provider)
    if provider:
        env["SCBENCH_PROBLEMS_PATH"] = str(root)
    return label, [str(ROOT / "bin" / "scb-extend"), "--new", str(config_path), problem, str(n)], env


def strict_job(config_path, n=None):
    """(label, argv, env) to run one config through bin/scb-strict, which halts on the first non-strict checkpoint."""
    label, argv, env = job_for(config_path, n)
    _, _, config, problem, count = argv
    return f"{label}-strict", [str(ROOT / "bin" / "scb-strict"), config, problem, count], env


def added_id(pueue_reply):
    """The id in pueue's `New task added (id N).`, wherever it sits in the reply."""
    m = re.search(r"New task added \(id (\d+)\)", pueue_reply)
    if not m:
        raise SystemExit(f"queue: pueue did not report a new task:\n{pueue_reply}")
    return int(m.group(1))


def solo_plan(tasks, task_id):
    """The other queued task ids, the ones `solo` stashes so only task_id runs."""
    return sorted(int(i) for i, t in tasks.items() if int(i) != task_id and state_of(t) == "Queued")


def add_task(label, argv, env, extra=()):
    """Enqueue a shell command through pueue and print the new task id last, whatever pueue warns."""
    cmd = shlex.join(["env", *(f"{k}={v}" for k, v in env.items()), *map(str, argv)])
    reply = subprocess.run([PUEUE, "add", "--label", label, "--working-directory", str(ROOT), *extra, "--", cmd],
                           capture_output=True, text=True, check=True).stdout
    task_id = added_id(reply)
    print(f"added task {task_id}: {label}")
    return task_id


def solo(task_id):
    tasks = json.loads(subprocess.run([PUEUE, "status", "--json"], capture_output=True, text=True, check=True).stdout)["tasks"]
    if state_of(tasks.get(str(task_id), {})) != "Queued":
        raise SystemExit(f"queue: task {task_id} is not queued")
    others = [str(i) for i in solo_plan(tasks, task_id)]
    if others:
        subprocess.run([PUEUE, "stash", *others], check=True, capture_output=True)
    subprocess.run([PUEUE, "start"], check=True, capture_output=True)
    time.sleep(3)
    subprocess.run([PUEUE, "pause", "--wait"], check=True, capture_output=True)
    if others:
        subprocess.run([PUEUE, "enqueue", *others], check=True, capture_output=True)
    print(f"task {task_id} running alone; {len(others)} job(s) queued behind a paused group")


def resume_job(run_dir, n=None, problem=None):
    """(label, argv, env) to continue a run from its next checkpoint through bin/scb-extend."""
    run_dir = pathlib.Path(run_dir).resolve()
    config = yaml.safe_load((run_dir / "config.yaml").read_text())
    problems = config["problems"]
    if problem is None:
        if len(problems) != 1:
            raise SystemExit("queue: multi-problem resume requires --problem NAME")
        problem = problems[0]
    elif problem not in problems:
        raise SystemExit(f"queue: {problem} is not in this run")
    root = run_problems_root(run_dir)
    n = n or len(list((root / problem).glob("checkpoint_*.md")))
    if not n:
        raise SystemExit(f"queue: no checkpoints found for {problem} under {root}; pass n_checkpoints")
    done = len(list((run_dir / problem).glob("checkpoint_*")))
    label = f"{run_dir.parent.name}-{problem}-resume-from-{done + 1}"
    env = {} if root == CACHE else {"SCBENCH_PROBLEMS_PATH": str(root)}
    provider = provider_env(config)
    env.update(provider)
    if provider:
        env["SCBENCH_PROBLEMS_PATH"] = str(root)
    return label, [str(ROOT / "bin" / "scb-extend"), str(run_dir), problem, str(n)], env


def resume_strict_job(run_dir, n=None, problem=None):
    """resume_job's plan, driven by bin/scb-strict so a non-strict checkpoint halts the rest."""
    label, argv, env = resume_job(run_dir, n, problem)
    return f"{label}-strict", [str(ROOT / "bin" / "scb-strict"), "--resume", *argv[1:]], env


def next_priority(tasks):
    """One above the highest priority of any queued task, so a new job runs before all of them."""
    queued = [t.get("priority", 0) or 0 for t in tasks.values() if state_of(t) == "Queued"]
    return max(queued, default=0) + 1


def swap_plan(order, moving, before):
    """The `pueue switch` pairs that walk `moving` through `order` (queued ids, run order) until it
    sits right before `before`. Each switch exchanges two positions, and the moving job takes the
    other id, so the plan is a chain of adjacent swaps following it."""
    order = list(order)
    if moving not in order or before not in order:
        raise SystemExit(f"queue: both jobs must be queued; queued ids are {order}")
    if moving == before:
        return []
    i, target = order.index(moving), order.index(before)
    if i > target:
        return [(order[k], order[k - 1]) for k in range(i, target, -1)]
    return [(order[k], order[k + 1]) for k in range(i, target - 1)]


def move_job(task_id, before_id):
    status = json.loads(subprocess.run([PUEUE, "status", "--json"], capture_output=True, text=True, check=True).stdout)
    tasks = status["tasks"]
    order = sorted((int(i) for i, t in tasks.items() if state_of(t) == "Queued"),
                   key=lambda i: (-(tasks[str(i)].get("priority", 0) or 0), i))
    for a, b in swap_plan(order, task_id, before_id):
        subprocess.run([PUEUE, "switch", str(a), str(b)], check=True, capture_output=True)
    status = json.loads(subprocess.run([PUEUE, "status", "--json"], capture_output=True, text=True, check=True).stdout)
    for i, t in sorted(status["tasks"].items(), key=lambda kv: int(kv[0])):
        if state_of(t) in ("Running", "Queued"):
            print(f"{i:>3} {state_of(t):<8} {t.get('label') or t['command'][:60]}")


def state_of(task):
    """A pueue task's state name: its status is a string or a one-key object."""
    s = task["status"]
    return s if isinstance(s, str) else next(iter(s))


def descendants(roots, table):
    """`roots` plus every process below them, from a (pid, ppid) table."""
    found = set(roots)
    while True:
        more = {pid for pid, ppid in table if ppid in found and pid not in found}
        if not more:
            return found
        found |= more


def job_roots(command, table, self_pid):
    """Pids running the job's command: those whose argv names its config file.

    The wrapper's own argv carries only the task id, so it never matches itself; the
    check against `self_pid` and "bin/queue" is belt and braces."""
    m = re.search(r"(\S+\.yaml)", command)
    key = pathlib.Path(m.group(1)).name if m else command[:80]
    return {pid for pid, _, args in table if key in args and pid != self_pid and "bin/queue" not in args}


def agent_containers(ps_lines):
    """Container ids from `docker ps --format '{{.ID}} {{.Image}}'` lines whose image is a slop-code agent."""
    return [line.split()[0] for line in ps_lines if len(line.split()) > 1 and line.split()[1].startswith("slop-code:")]


def process_table():
    out = subprocess.run(["ps", "-eo", "pid,ppid,args"], capture_output=True, text=True, check=True).stdout
    rows = []
    for line in out.splitlines()[1:]:
        parts = line.split(None, 2)
        if len(parts) >= 2:
            rows.append((int(parts[0]), int(parts[1]), parts[2] if len(parts) > 2 else ""))
    return rows


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def kill_job(task_id, keep_paused=False):
    """Stop one job without leaving a worker or an agent container behind.

    Killing only the pueue task leaves slop-code's spawned worker (it reparents to init) and
    the agent's docker container running, both still spending the subscription. The queue
    is paused while cleaning up so the next job cannot start a container that would then
    look like an orphan; with one job at a time in the group, once the killed job's
    processes are gone every agent container is an orphan."""
    status = json.loads(subprocess.run([PUEUE, "status", "--json"], capture_output=True, text=True, check=True).stdout)
    tasks = status["tasks"]
    task = tasks.get(str(task_id))
    if task is None:
        raise SystemExit(f"queue: no task {task_id}")
    state = state_of(task)
    if state == "Queued":
        subprocess.run([PUEUE, "remove", str(task_id)], check=True)
        print(f"removed queued task {task_id}")
        return
    if state != "Running":
        raise SystemExit(f"queue: task {task_id} is {state}; nothing to kill")
    others = [i for i, t in tasks.items() if i != str(task_id) and state_of(t) == "Running"]
    subprocess.run([PUEUE, "pause", "--wait"], check=True, capture_output=True)
    try:
        table = process_table()
        pids = descendants(job_roots(task["command"], [(p, pp, a) for p, pp, a in table], os.getpid()), [(p, pp) for p, pp, _ in table])
        subprocess.run([PUEUE, "kill", str(task_id)], check=True, capture_output=True)
        time.sleep(3)
        for sig in (signal.SIGTERM, signal.SIGKILL):
            survivors = sorted(p for p in pids if alive(p))
            for p in survivors:
                try:
                    os.kill(p, sig)
                except ProcessLookupError:
                    pass
            if survivors:
                print(f"{sig.name} to surviving job processes: {survivors}")
                time.sleep(5)
        if others:
            print(f"tasks {others} still running; leaving containers alone")
        else:
            ps = subprocess.run(["docker", "ps", "--format", "{{.ID}} {{.Image}}"], capture_output=True, text=True).stdout.splitlines()
            for c in agent_containers(ps):
                subprocess.run(["docker", "rm", "-f", c], check=True, capture_output=True)
                print(f"removed agent container {c}")
    finally:
        if keep_paused:
            print(f"killed task {task_id}; queue left paused (pueue start to continue)")
        else:
            subprocess.run([PUEUE, "start"], check=True, capture_output=True)
            print(f"killed task {task_id}; queue resumed")


def main():
    args = sys.argv[1:]
    if args and args[0] == "add":
        first = args[1:2] == ["--next"]
        rest = args[2:] if first else args[1:]
        label, argv, env = job_for(rest[0], int(rest[1]) if len(rest) > 1 else None)
        extra = []
        if first:
            tasks = json.loads(subprocess.run([PUEUE, "status", "--json"], capture_output=True, text=True, check=True).stdout)["tasks"]
            extra = ["--priority", str(next_priority(tasks))]
        add_task(label, argv, env, extra)
    elif args[:1] == ["add-strict"] and len(args) in (2, 3):
        add_task(*strict_job(args[1], int(args[2]) if len(args) > 2 else None))
    elif args[:1] == ["solo"] and len(args) == 2:
        solo(int(args[1]))
    elif args[:1] == ["move"] and len(args) == 4 and args[2] == "before":
        move_job(int(args[1]), int(args[3]))
    elif args[:1] in (["resume"], ["resume-strict"]):
        import argparse
        parser = argparse.ArgumentParser(prog=f"queue {args[0]}")
        parser.add_argument("run_dir")
        parser.add_argument("n", nargs="?", type=int)
        parser.add_argument("--problem")
        options = parser.parse_args(args[1:])
        plan = resume_strict_job if args[0] == "resume-strict" else resume_job
        add_task(*plan(options.run_dir, options.n, options.problem))
    elif args[:1] == ["kill"] and len(args) in (2, 3) and args[3:] == [] and (len(args) == 2 or args[2] == "--keep-paused"):
        kill_job(int(args[1]), keep_paused=len(args) == 3)
    elif not args:
        subprocess.run([PUEUE, "status"], check=True)
    else:
        subprocess.run([PUEUE, *args], check=True)


if __name__ == "__main__":
    main()
