+def test_timeout_calls_on_timeout_before_waiting_for_the_stream() -> None:
+    """A silent command must be stopped by the hook, not waited out.
+
+    The pump thread blocks in a read until the underlying process ends, so
+    without the hook a timed-out `sleep 600` holds process_stream for 600s.
+    """
+    released = threading.Event()
+    hook_calls: list[float] = []
+
+    def silent_stream():
+        released.wait()
+        yield from ()
+
+    def on_timeout() -> None:
+        hook_calls.append(time.monotonic())
+        released.set()
+
+    start = time.monotonic()
+    gen = process_stream(silent_stream(), 0.2, lambda: None, on_timeout=on_timeout)
+    events = []
+    try:
+        while True:
+            events.append(next(gen))
+    except StopIteration as stop:
+        result = stop.value
+
+    assert result.timed_out is True
+    assert len(hook_calls) == 1
+    assert time.monotonic() - start < 5
+    assert events == []
