#!/usr/bin/env python3
"""Blind-judge the readings a tester recorded in AMBIGUITIES.md.

For every entry the judge sees the cumulative spec up to that entry's checkpoint,
the quoted spec text and the candidate readings, and nothing else: not the
tester's choice, its rationale, its tests, or the implementation. It answers with
the reading it thinks the spec author intended. Alternatives are shuffled per
sample so a position preference shows up as noise rather than as a vote.

Eight variants, three binary switches:
  mode    choose   answer with a reading number (or "other" + the rule)
          rule     write the intended rule first, then map it to a reading
  both    add: readings may not be exclusive; "all of them at once" is a reading
  impl    add: implementability is the implementer's problem, judge the text only

Entries are judged in batches: one call takes up to --batch entries of the same
checkpoint (a fresh random partition per variant and sample), because Claude Code
print mode does not cache a custom system prompt between calls, so the spec is
paid for once per call rather than once per entry.

Judging runs through Claude Code print mode on the subscription token, the same
auth path as bin/scb; no API key is used.

  bin/judge-ambiguities plan   <run_dir> --out <dir> [--entries T74,T27] [--variants ...] [--samples 5]
  bin/judge-ambiguities run    <run_dir> --out <dir> [same filters] [--batch 15] [--workers 4] [--pause-at 85]
  bin/judge-ambiguities summarize <dir>

To judge against a clarified spec, point SCBENCH_PROBLEMS_PATH at a problem root
holding the patched copy and pass --spec-patch <patch>: entries whose quoted
spec text contains a sentence the patch rewrote get the new wording too.

<run_dir> is a slop-code run dir holding <problem>/checkpoint_N/snapshot/AMBIGUITIES.md;
the problem is inferred when the run has one, else pass --problem.
Results append to <dir>/judgments.jsonl; a re-run skips judgments already there.
"""
from __future__ import annotations

import argparse
import collections
import dataclasses
import datetime as dt
import hashlib
import json
import os
import random
import re
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO = HERE.parent
PROBLEM_ROOT = Path(os.environ.get("SCBENCH_PROBLEMS_PATH") or Path.home() / ".cache/scbench/problems")
# The benchmark's own override variable, so a patched copy works the same way.
TOKEN_FILE = Path(os.environ.get("SCB_OAUTH_TOKEN_FILE", Path.home() / ".config/scbench/claude-oauth-token"))
MODEL = "claude-opus-5"

# Readings the hidden tests turned out to want, for the entries whose choice cost
# tests in the v7 run. A judge answer in the set counts as matching the hidden
# reading. T74's hidden tests reject a value-bearing force AND a repeated one,
# so "both" is right there too.
HIDDEN_OK = {"T22": {1}, "T27": {1}, "T56": {1}, "T63": {1}, "T74": {1, "both"}}  # datagate v7; other problems: --hidden

VARIANTS = {
    f"{mode}{'+both' if both else ''}{'+impl' if impl else ''}": (mode, both, impl)
    for mode in ("choose", "rule")
    for both in (False, True)
    for impl in (False, True)
}

BOTH_TEXT = (
    "The listed readings may not be mutually exclusive. If more than one of them "
    "can hold at the same time, treat \"all of them together\" as a further reading, "
    "and choose it (answer \"both\") if that is what the author most plausibly meant."
)
IMPL_TEXT = (
    "Do not weigh how hard, or even how possible, a reading is to implement. That "
    "is the implementer's problem, not yours: if the text says it, the implementer "
    "will find a way. Judge only what the author most plausibly meant."
)


@dataclasses.dataclass
class Entry:
    id: str
    title: str
    spec_text: str
    alternatives: list[str]
    choice: int | None
    choice_raw: str = ""
    checkpoint: int = 0


# --------------------------------------------------------------------------- parsing

ENTRY_RE = re.compile(r"^## (?P<id>[TI]\d+) — (?P<title>.*)$", re.M)


def parse_registry(text: str) -> list[Entry]:
    heads = list(ENTRY_RE.finditer(text))
    entries = []
    for i, m in enumerate(heads):
        body = text[m.end(): heads[i + 1].start() if i + 1 < len(heads) else len(text)]
        spec = _section(body, "Spec Text")
        alts = _section(body, "Alternatives")
        choice_raw = _section(body, "Choice")
        alternatives = _split_alternatives(alts)
        cm = re.match(r"\s*—\s*\((\d+)\)", choice_raw)
        entries.append(Entry(
            id=m.group("id"), title=m.group("title").strip(), spec_text=spec.strip(),
            alternatives=alternatives, choice=int(cm.group(1)) if cm else None,
            choice_raw=choice_raw.strip(),
        ))
    return entries


def _section(body: str, name: str) -> str:
    m = re.search(rf"^\*\*{re.escape(name)}\*\*(.*?)(?=^\*\*[A-Z][^*]*\*\*|^---|\Z)", body, re.M | re.S)
    return m.group(1) if m else ""


def _split_alternatives(block: str) -> list[str]:
    alts: list[str] = []
    for line in block.strip().splitlines():
        if re.match(r"^\d+\. ", line):
            alts.append(re.sub(r"^\d+\. ", "", line).strip())
        elif alts and line.strip():
            alts[-1] += " " + line.strip()
    return alts


def infer_problem(run_dir: Path) -> str:
    """The one problem in the run dir that has registry snapshots."""
    names = sorted({p.parts[-4] for p in run_dir.glob("*/checkpoint_*/snapshot/AMBIGUITIES.md")})
    if len(names) != 1:
        sys.exit(f"pass --problem: found {names or 'no'} problems with AMBIGUITIES.md under {run_dir}")
    return names[0]


def load_entries(run_dir: Path, problem: str) -> list[Entry]:
    """Entries from the last checkpoint's registry, each tagged with the checkpoint
    it first appeared in, so the judge sees the spec the tester had."""
    snaps = sorted((p for p in run_dir.glob(f"{problem}/checkpoint_*/snapshot/AMBIGUITIES.md")
                    if re.fullmatch(r"checkpoint_\d+", p.parts[-3])),  # skip *.partial dirs
                   key=lambda p: int(p.parts[-3].split("_")[1]))
    if not snaps:
        sys.exit(f"no AMBIGUITIES.md snapshots under {run_dir}")
    first_seen: dict[str, int] = {}
    for snap in snaps:
        n = int(snap.parts[-3].split("_")[1])
        for e in parse_registry(snap.read_text()):
            first_seen.setdefault(e.id, n)
    entries = parse_registry(snaps[-1].read_text())
    for e in entries:
        e.checkpoint = first_seen[e.id]
    return entries


def patch_sentences(patch_text: str) -> list[tuple[str, str]]:
    """(old, new) line pairs from a unified diff, whitespace-normalized."""
    pairs, minus = [], []
    for line in patch_text.splitlines():
        if line.startswith("---") or line.startswith("+++"):
            continue
        if line.startswith("-"):
            minus.append(_squash(line[1:]))
        elif line.startswith("+") and minus:
            pairs.append((minus.pop(0), _squash(line[1:])))
        else:
            minus = []
    return pairs


def _squash(text: str) -> str:
    return re.sub(r"\s+", " ", text).strip()


def rewrite_quotes(entries: list[Entry], pairs: list[tuple[str, str]]) -> list[str]:
    """Replace patched sentences inside each entry's quoted spec text. The quote
    is unwrapped first, since the tester wrapped sentences across '> ' lines.
    Returns the ids of the entries that changed."""
    changed = []
    for e in entries:
        flat = _squash(re.sub(r"(?m)^>\s?", "", e.spec_text))
        new = flat
        for old, repl in pairs:
            if old in new:
                new = new.replace(old, repl)
                continue
            # The patched line may be a whole table row; the entry usually quotes
            # one sentence of it. Substitute sentence by sentence when they align.
            olds, news = _sentences(old), _sentences(repl)
            if len(olds) == len(news):
                for o, n in zip(olds, news):
                    if o != n and o in new:
                        new = new.replace(o, n)
        if new != flat:
            e.spec_text = "> " + new
            changed.append(e.id)
    return changed


def _sentences(line: str) -> list[str]:
    return [f.strip() for f in re.split(r"(?<=[.!?])\s+", line) if f.strip()]


def cumulative_spec(problem: str, checkpoint: int) -> str:
    parts = []
    for n in range(1, checkpoint + 1):
        parts.append(f"<!-- checkpoint {n} -->\n" + (PROBLEM_ROOT / problem / f"checkpoint_{n}.md").read_text().strip())
    return "\n\n".join(parts)


# --------------------------------------------------------------------------- prompts

def system_prompt(spec: str, variant: str) -> str:
    mode, both, impl = VARIANTS[variant]
    lines = [
        "You are judging how the author of a software specification intended an "
        "under-specified passage to be read. You will see the specification and a "
        "numbered list of ambiguities, each with the quoted passage and candidate "
        "readings, numbered. For each ambiguity, independently, decide which reading "
        "the author most plausibly intended.",
    ]
    if both:
        lines.append(BOTH_TEXT)
    if impl:
        lines.append(IMPL_TEXT)
    if mode == "rule":
        lines.append(
            "Answer with a JSON array only, one object per ambiguity, keys in this order: "
            '{"id": <the ambiguity label>, "rule": <the behaviour the author intended, one '
            'sentence, written from the specification before consulting the candidate '
            'readings>, "choice": <the number of the reading that matches your rule, or "other">}.'
        )
    else:
        lines.append(
            "Answer with a JSON array only, one object per ambiguity: "
            '{"id": <the ambiguity label>, "choice": <the number of the intended reading, '
            'or "other">, "rule": <the intended behaviour in one sentence>}.'
        )
    lines.append("SPECIFICATION (all checkpoints so far, cumulative):\n\n" + spec)
    return "\n\n".join(lines)


def user_prompt(batch: list[tuple[str, Entry, list[int]]]) -> str:
    """batch: (label, entry, shuffled order) triples."""
    blocks = []
    for label, entry, order in batch:
        alts = "\n".join(f"{i + 1}. {entry.alternatives[j]}" for i, j in enumerate(order))
        blocks.append(f"### {label}: {entry.title}\n\nSpec text:\n{entry.spec_text}\n\n"
                      f"Candidate readings:\n{alts}")
    return "AMBIGUITIES\n\n" + "\n\n".join(blocks) + "\n\nFor each ambiguity, which reading did the author intend?"


def shuffled_order(entry: Entry, variant: str, sample: int) -> list[int]:
    seed = int(hashlib.sha256(f"{entry.id}|{variant}|{sample}".encode()).hexdigest(), 16)
    order = list(range(len(entry.alternatives)))
    random.Random(seed).shuffle(order)
    return order


def normalize_choice(raw, order: list[int]):
    """Map the judge's answer (numbered in shuffled order) back to the entry's numbering."""
    if isinstance(raw, bool):
        return "other"
    if isinstance(raw, int):
        return order[raw - 1] + 1 if 1 <= raw <= len(order) else "other"
    s = str(raw).strip().lower()
    if re.fullmatch(r"\d+", s):
        return normalize_choice(int(s), order)
    if s in ("both", "all") or re.search(r"\b(both|all|and)\b", s):
        return "both"
    return "other"


def parse_result(text: str) -> dict[str, dict] | None:
    """The judge's JSON array, keyed by ambiguity label."""
    def labelled(items) -> dict[str, dict]:
        return {str(it["id"]).strip(): it for it in items if isinstance(it, dict) and "id" in it}

    m = re.search(r"\[.*\]", text, re.S)
    if m:
        try:
            found = labelled(json.loads(m.group(0)))
            if found:
                return found
        except (json.JSONDecodeError, TypeError):
            pass
    # No well-formed array: the judge sometimes emits the objects bare, one per
    # line. They are flat, so brace matching is enough.
    objects = []
    for obj in re.findall(r"\{[^{}]*\}", text, re.S):
        try:
            objects.append(json.loads(obj))
        except json.JSONDecodeError:
            continue
    return labelled(objects) or None


def partition(entries: list[Entry], variant: str, sample: int, size: int) -> list[list[Entry]]:
    """Near-equal random batches of one checkpoint's entries, fixed per (variant, sample)."""
    if not entries:
        return []
    ckpt = entries[0].checkpoint
    seed = int(hashlib.sha256(f"batch|{ckpt}|{variant}|{sample}".encode()).hexdigest(), 16)
    pool = list(entries)
    random.Random(seed).shuffle(pool)
    n_batches = -(-len(pool) // size)
    return [pool[i::n_batches] for i in range(n_batches)]


# --------------------------------------------------------------------------- judging

def claude_env() -> dict[str, str]:
    env = {k: v for k, v in os.environ.items() if not k.upper().startswith("ANTHROPIC")}
    token = TOKEN_FILE.read_text().strip()
    if not token.startswith("sk-ant-oat01-"):
        sys.exit(f"{TOKEN_FILE} does not hold a Claude OAuth token")
    env["CLAUDE_CODE_OAUTH_TOKEN"] = token
    return env


def judge_once(system: str, user: str, env: dict[str, str], timeout: int = 240) -> dict:
    cmd = ["claude", "-p", "--model", MODEL, "--system-prompt", system, "--tools", "",
           "--no-session-persistence", "--output-format", "json", user]
    t0 = time.monotonic()
    proc = subprocess.run(cmd, env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=timeout)
    elapsed = time.monotonic() - t0
    if proc.returncode != 0:
        return {"error": f"exit {proc.returncode}: {proc.stderr.strip()[:300]}", "elapsed": elapsed}
    try:
        out = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return {"error": "non-json output: " + proc.stdout[:200], "elapsed": elapsed}
    usage = out.get("usage") or {}
    return {
        "result": out.get("result", ""), "cost": out.get("total_cost_usd"), "elapsed": elapsed,
        "cache_read": usage.get("cache_read_input_tokens"), "cache_write": usage.get("cache_creation_input_tokens"),
        "output_tokens": usage.get("output_tokens"),
    }


def five_hour_pct() -> tuple[float, str] | None:
    try:
        out = subprocess.run([str(HERE / "usage")], capture_output=True, text=True, timeout=30).stdout
        d = json.loads(out)["five_hour"]
        return float(d["pct"]), d["resets_at"]
    except Exception:
        return None


def wait_for_reset(resets_at: str) -> None:
    until = dt.datetime.fromisoformat(resets_at) + dt.timedelta(seconds=90)
    while dt.datetime.now(dt.timezone.utc) < until:
        time.sleep(60)


def build_plan(entries: list[Entry], variants: list[str], samples: int, size: int,
               done: set[tuple[str, str, int]]) -> list[tuple[list[Entry], str, int]]:
    """Batches still to judge: entries of one checkpoint, per variant and sample,
    minus those already judged."""
    by_ckpt = collections.defaultdict(list)
    for e in entries:
        by_ckpt[e.checkpoint].append(e)
    plan = []
    for ckpt in sorted(by_ckpt):
        for v in variants:
            for s in range(samples):
                todo = [e for e in by_ckpt[ckpt] if (e.id, v, s) not in done]
                plan.extend((b, v, s) for b in partition(todo, v, s, size))
    return plan


def done_keys(out: Path) -> set[tuple[str, str, int]]:
    f = out / "judgments.jsonl"
    if not f.exists():
        return set()
    keys = set()
    for line in f.read_text().splitlines():
        if line.strip():
            r = json.loads(line)
            if "error" not in r:
                keys.add((r["entry"], r["variant"], r["sample"]))
    return keys


def cmd_run(args, dry: bool) -> None:
    problem = args.problem or infer_problem(Path(args.run_dir))
    entries = select_entries(load_entries(Path(args.run_dir), problem), args.entries)
    if args.spec_patch:
        changed = rewrite_quotes(entries, patch_sentences("\n".join(Path(f).read_text() for f in args.spec_patch)))
        print(f"spec patch {args.spec_patch}: problem root {PROBLEM_ROOT}; rewrote quotes in {', '.join(changed) or 'no entries'}", flush=True)
    variants = args.variants.split(",") if args.variants else list(VARIANTS)
    for v in variants:
        if v not in VARIANTS:
            sys.exit(f"unknown variant {v}; choose from {', '.join(VARIANTS)}")
    out = Path(args.out); out.mkdir(parents=True, exist_ok=True)
    done = done_keys(out)
    todo = build_plan(entries, variants, args.samples, args.batch, done)
    n_judgments = sum(len(b) for b, _, _ in todo)
    print(f"{len(entries)} entries x {len(variants)} variants x {args.samples} samples = "
          f"{len(entries) * len(variants) * args.samples} judgments; {len(done)} done, "
          f"{n_judgments} to run in {len(todo)} calls of up to {args.batch}", flush=True)
    if dry:
        for e in entries:
            print(f"  {e.id} ckpt{e.checkpoint} alts={len(e.alternatives)} tester={e.choice} :: {e.title[:70]}")
        return
    env = claude_env()
    specs = {n: cumulative_spec(problem, n) for n in {e.checkpoint for e in entries}}
    lock = threading.Lock()
    state = {"n": 0, "cost": 0.0, "errors": 0, "paused": False}
    log = (out / "judgments.jsonl").open("a")

    def one(task):
        batch, v, s = task
        while state["paused"]:
            time.sleep(15)
        labelled = [(f"A{i + 1}", e, shuffled_order(e, v, s)) for i, e in enumerate(batch)]
        ckpt = batch[0].checkpoint
        res = judge_once(system_prompt(specs[ckpt], v), user_prompt(labelled), env)
        parsed = parse_result(res["result"]) if "error" not in res else None
        at = dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")
        batch_ids = [e.id for e in batch]
        recs = []
        for label, e, order in labelled:
            rec = {"entry": e.id, "checkpoint": ckpt, "variant": v, "sample": s, "order": order,
                   "tester": e.choice, "batch": batch_ids, "at": at,
                   "cost": (res.get("cost") or 0.0) / len(batch), "elapsed": res.get("elapsed")}
            if "error" in res:
                rec["error"] = res["error"]
            elif parsed is None:
                rec["error"] = "unparsable result: " + res["result"][:200]
            elif label not in parsed:
                rec["error"] = f"no answer for {label}"
            else:
                item = parsed[label]
                rec["choice"] = normalize_choice(item.get("choice"), order)
                rec["choice_raw"] = item.get("choice")
                rec["rule"] = item.get("rule")
            recs.append(rec)
        with lock:
            for rec in recs:
                log.write(json.dumps(rec) + "\n")
            log.flush()
            state["n"] += 1; state["cost"] += res.get("cost") or 0.0
            state["errors"] += sum("error" in r for r in recs)
            n = state["n"]
            if n % 5 == 0 or n == len(todo):
                print(f"[{n}/{len(todo)} calls] cost=${state['cost']:.2f} errors={state['errors']} "
                      f"last=ckpt{ckpt}/{v}#{s} x{len(batch)} ({res.get('elapsed', 0):.0f}s)", flush=True)
            if n % args.check_every == 0:
                u = five_hour_pct()
                if u and u[0] >= args.pause_at:
                    print(f"5h window at {u[0]}%, pausing until {u[1]}", flush=True)
                    state["paused"] = True
                    threading.Thread(target=lambda: (wait_for_reset(u[1]), state.update(paused=False),
                                                     print("resumed", flush=True)), daemon=True).start()
        return recs

    with ThreadPoolExecutor(max_workers=args.workers) as pool:
        futures = [pool.submit(one, t) for t in todo]
        for f in as_completed(futures):
            f.result()
    log.close()
    print(f"done: {state['n']} calls, ${state['cost']:.2f}, {state['errors']} errored judgments", flush=True)


def select_entries(entries: list[Entry], spec: str | None) -> list[Entry]:
    if not spec:
        return entries
    wanted = set(spec.split(","))
    chosen = [e for e in entries if e.id in wanted]
    missing = wanted - {e.id for e in chosen}
    if missing:
        sys.exit(f"unknown entries: {', '.join(sorted(missing))}")
    return chosen


# --------------------------------------------------------------------------- summary

def cmd_summarize(args) -> None:
    out = Path(args.out)
    recs = [json.loads(l) for l in (out / "judgments.jsonl").read_text().splitlines() if l.strip()]
    recs = [r for r in recs if "error" not in r]
    by = collections.defaultdict(list)
    for r in recs:
        by[(r["entry"], r["variant"])].append(r)
    entries = sorted({r["entry"] for r in recs}, key=lambda s: (s[0], int(s[1:])))
    variants = [v for v in VARIANTS if any((e, v) in by for e in entries)]
    cost = sum(r.get("cost") or 0 for r in recs)
    print(f"{len(recs)} judgments, ${cost:.2f}; entries={len(entries)} variants={variants}\n")
    print("Per variant: share of votes agreeing with the tester, and on the 5 known entries with the hidden reading")
    for v in variants:
        vs = [r for r in recs if r["variant"] == v]
        agree = sum(r["choice"] == r["tester"] for r in vs)
        known = [r for r in vs if r["entry"] in HIDDEN_OK]
        hidden = sum(r["choice"] in HIDDEN_OK[r["entry"]] for r in known)
        pos1 = sum(r.get("choice_raw") in (1, "1") for r in vs)
        print(f"  {v:18s} agree_with_tester={agree}/{len(vs)}  hidden_reading={hidden}/{len(known)}  "
              f"picked_position_1={pos1}/{len(vs)}")
    print("\nPer entry (vote = choice:count over all samples of the variant)")
    print(f"  {'entry':6s} {'tester':6s} {'hidden':7s} " + " ".join(f"{v[:14]:14s}" for v in variants))
    for e in entries:
        hidden = ",".join(str(x) for x in sorted(HIDDEN_OK.get(e, set()), key=str)) or "-"
        tester = by[(e, variants[0])][0]["tester"] if (e, variants[0]) in by else "?"
        cells = []
        for v in variants:
            c = collections.Counter(r["choice"] for r in by.get((e, v), []))
            cells.append(",".join(f"{k}:{n}" for k, n in sorted(c.items(), key=lambda kv: -kv[1]))[:14].ljust(14))
        flag = " <- MISS" if e in HIDDEN_OK else ""
        print(f"  {e:6s} {str(tester):6s} {hidden:7s} " + " ".join(cells) + flag)


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("plan", "run"):
        p = sub.add_parser(name)
        p.add_argument("run_dir"); p.add_argument("--out", required=True)
        p.add_argument("--problem", help="problem name inside the run dir (inferred when there is one)")
        p.add_argument("--entries"); p.add_argument("--variants"); p.add_argument("--samples", type=int, default=5)
        p.add_argument("--batch", type=int, default=15)
        p.add_argument("--spec-patch", action="append", default=[], help="unified diff of the specs; repeatable (specs/vN/*.patch); rewrites matching quoted sentences in entries")
        p.add_argument("--workers", type=int, default=4); p.add_argument("--pause-at", type=float, default=85)
        p.add_argument("--check-every", type=int, default=5)
    s = sub.add_parser("summarize"); s.add_argument("out")
    s.add_argument("--hidden", help='JSON {"T7": [1], "T9": [2, "both"]}: readings the hidden tests take, per entry')
    args = ap.parse_args()
    if getattr(args, "hidden", None):
        HIDDEN_OK.clear()
        HIDDEN_OK.update({k: set(v) for k, v in json.loads(args.hidden).items()})
    if args.cmd == "summarize":
        cmd_summarize(args)
    else:
        cmd_run(args, dry=args.cmd == "plan")


if __name__ == "__main__":
    main()
