#!/usr/bin/env python3
"""Gather everything needed to explain a run's hidden-test misses.

For a completed slop-code run, lists every hidden test that failed (once, however
many checkpoints it failed at), and for each: the test's docstring and assertion
lines from the problem's test file, the E lines pytest printed when it failed
(bin/test-failure), the spec lines near the words in the test's name, and the
registry entries (AMBIGUITIES.md) that share the rarest words with all of that
(bin/registry-scores ranks them). It does the gathering; deciding which entry a
test belongs to, and what the hidden reading is, is the reader's job.

  bin/miss-report <run_dir> [--problem P] [--out report.md] [--brief]

--brief prints only each miss and its candidate entries, the cases of one test folded
into a line; bin/run-recap shows that.

A run of a patched spec (-specvN in its folder name) reads the tests and spec under
specs/<problem>/vN/problems; any other run reads the catalog root
(SCBENCH_PROBLEMS_PATH or ~/.cache/scbench/problems). The registry is the one in the
run's last snapshot that has one.
"""
from __future__ import annotations

import argparse
import collections
import json
import os
import re
import sys
import types
from pathlib import Path

HERE = Path(__file__).resolve().parent
SPECS = HERE.parent / "specs"
PROBLEM_ROOT = Path(os.environ.get("SCBENCH_PROBLEMS_PATH") or Path.home() / ".cache/scbench/problems")
CANDIDATES = 3
SHARED_SHOWN = 8
FAILURE_LINES = 6
FAILURE_WIDTH = 240
# Words of any test's source or pytest's output; they say nothing about which entry a test is near.
CODE_NOISE = {"assert", "self", "pytest", "mark", "parametrize", "fixture", "none", "true", "false",
              "str", "int", "len", "where", "run", "result", "def", "return"}


def sibling(name):
    """Another bin script, loaded as a module."""
    module = types.ModuleType(name.replace("-", "_"))
    module.__file__ = str(HERE / name)
    exec(compile((HERE / name).read_text(), str(HERE / name), "exec"), module.__dict__)
    return module


registry_scores = sibling("registry-scores")
test_failure = sibling("test-failure")


def problem_root(run_dir: Path, problem: str, specs: Path = SPECS, default: Path = PROBLEM_ROOT) -> Path:
    """The catalog the run was scored against: its spec version's, when the run names one that exists."""
    version = re.search(r"-spec(v\d+)$", run_dir.parent.name)
    patched = specs / problem / version.group(1) / "problems" if version else None
    return patched if patched and (patched / problem).is_dir() else default


def failing_tests(run_dir: Path, problem: str) -> dict[tuple[int, str], list[int]]:
    """(origin checkpoint, test name) -> run checkpoints it failed at."""
    fails: dict[tuple[int, str], list[int]] = collections.defaultdict(list)
    for ev in sorted(run_dir.glob(f"{problem}/checkpoint_*/evaluation.json")):
        if not re.fullmatch(r"checkpoint_\d+", ev.parent.name):
            continue
        n = int(ev.parent.name.split("_")[1])
        data = json.loads(ev.read_text())
        for group, res in (data.get("tests") or {}).items():
            origin = int(re.match(r"checkpoint_(\d+)", group).group(1))
            for name in res.get("failed") or []:
                fails[(origin, name.split("::")[-1])].append(n)
    return fails


def test_source(root: Path, problem: str, origin: int, name: str) -> tuple[str, list[str]]:
    """Docstring and the lines that carry the expectation."""
    base = re.sub(r"\[.*\]$", "", name)
    path = root / problem / "tests" / f"test_checkpoint_{origin}.py"
    if not path.exists():
        return f"(no {path.name} under {path.parent})", []
    m = re.search(
        rf"(?:^[ \t]*@[^\n]*\n)*^[ \t]*def {re.escape(base)}\(.*?(?=^[ \t]*(?:@|def )|^class |\Z)",
        path.read_text(),
        re.S | re.M,
    )
    if not m:
        return "(test not found in the problem's test file)", []
    body = m.group(0)
    doc = re.search(r'"""(.*?)"""', body, re.S)
    keep = [
        line.strip()
        for line in body.splitlines()
        if re.search(r"assert|params=|parametrize|encode\(|status_code|set_route|\.get\(|\.post\(", line)
    ]
    return (doc.group(1).strip() if doc else "-"), keep[:10]


def failure_lines(run_dir: Path, problem: str, checkpoint: int, name: str) -> list[str]:
    """The E lines pytest printed for this test at one run checkpoint."""
    stdout = run_dir / problem / f"checkpoint_{checkpoint}" / "evaluation" / "stdout.txt"
    if not stdout.exists():
        return []
    for title, body in test_failure.failure_sections(stdout.read_text(errors="replace")):
        if title == name or title.endswith(f".{name}"):
            return [line for line in body if line.startswith("E  ")][:FAILURE_LINES]
    return []


def spec_lines_near(root: Path, problem: str, origin: int, words: set[str], radius: int = 1) -> list[str]:
    spec = root / problem / f"checkpoint_{origin}.md"
    if not spec.exists():
        return []
    lines = spec.read_text().splitlines()
    hits = [i for i, line in enumerate(lines) if any(re.search(rf"\b{re.escape(w)}", line, re.I) for w in words)]
    out, seen = [], set()
    for i in hits:
        for j in range(max(0, i - radius), min(len(lines), i + radius + 1)):
            if j not in seen and lines[j].strip():
                seen.add(j)
                out.append(f"{j + 1}: {lines[j]}")
    return out[:12]


def registry(run_dir: Path, problem: str) -> list[dict]:
    """The entries of the last checkpoint's AMBIGUITIES.md, as bin/registry-scores parses them."""
    snaps = sorted(
        (
            p
            for p in run_dir.glob(f"{problem}/checkpoint_*/snapshot/AMBIGUITIES.md")
            if re.fullmatch(r"checkpoint_\d+", p.parts[-3])
        ),
        key=lambda p: int(p.parts[-3].split("_")[1]),
    )
    return registry_scores.entries(snaps[-1].read_text()) if snaps else []


def gather(run_dir: Path, problem: str, root: Path, entries: list[dict]) -> list[dict]:
    """One record per distinct failing test: where it failed, its source, its output, its candidate entries."""
    misses = []
    for (origin, name), at in sorted(failing_tests(run_dir, problem).items()):
        doc, keep = test_source(root, problem, origin, name)
        output = failure_lines(run_dir, problem, at[-1], name)
        around = registry_scores.words(" ".join([doc, *keep, *output])) - CODE_NOISE
        candidates = registry_scores.near(entries, around, named=registry_scores.words(name))[:CANDIDATES]
        misses.append({"origin": origin, "name": name, "at": at, "doc": doc, "keep": keep,
                       "output": [line[:FAILURE_WIDTH] for line in output], "candidates": candidates})
    return misses


def shown(shared: list[str]) -> str:
    more = len(shared) - SHARED_SHOWN
    return ", ".join(shared[:SHARED_SHOWN]) + (f", +{more}" if more > 0 else "")


def brief(misses: list[dict], entries: list[dict]) -> list[str]:
    if not misses:
        return ["no failing tests in this run"]
    count = f"{len(misses)} failing test{'s' if len(misses) > 1 else ''}"
    if not entries:
        return [f"{count}; this run kept no registry (AMBIGUITIES.md)"]
    lines = [f"{count}, {len(entries)} registry entries; candidates by shared words, read them before citing"]
    cases = collections.defaultdict(list)
    for miss in misses:
        cases[(miss["origin"], re.sub(r"\[.*\]$", "", miss["name"]))].append(miss)
    for same in cases.values():
        more = len(same) - 1
        lines.append(same[0]["name"] + (f" (+{more} more case{'s' if more > 1 else ''})" if more else ""))
        if not same[0]["candidates"]:
            lines.append("  no entry shares a telling word with this test")
        for entry, shared in same[0]["candidates"]:
            risk = "-" if entry["score"] is None else entry["score"]
            lines.append(f"  {risk:>3}  {entry['head'][:90]}  [{shown(shared)}]")
    return lines


def report(run_dir: Path, problem: str, root: Path, misses: list[dict], entries: list[dict]) -> list[str]:
    lines = [
        f"# Hidden-test misses: {problem}",
        "",
        f"Run: `{run_dir}`",
        "",
        f"{len(misses)} distinct failing tests; {len(entries)} registry entries.",
        "",
    ]
    for miss in misses:
        lines += [
            f"## checkpoint {miss['origin']}: `{miss['name']}`",
            "",
            f"Failed at run checkpoints {', '.join(map(str, miss['at']))}.",
            "",
            f"> {miss['doc']}",
            "",
        ]
        lines += ["```", *miss["keep"], "```", ""] if miss["keep"] else []
        if miss["output"]:
            lines += [f"Failure output at run checkpoint {miss['at'][-1]}:", "", "```", *miss["output"], "```", ""]
        name_words = registry_scores.words(miss["name"])
        near = spec_lines_near(root, problem, miss["origin"], {w for w in name_words if len(w) > 3} or name_words)
        if near:
            lines += ["Spec lines near the test's words:", "", "```", *near, "```", ""]
        if miss["candidates"]:
            lines += ["Candidate registry entries (by the rare words they share with the test and its output):", ""]
            lines += [
                f"- {entry['head']} (Risk {entry['score']}) [{shown(shared)}]"
                for entry, shared in miss["candidates"]
            ]
            lines += [""]
    return lines


def main(argv=None) -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("run_dir")
    ap.add_argument("--problem")
    ap.add_argument("--out")
    ap.add_argument("--brief", action="store_true", help="only each miss and its candidate entries")
    ap.add_argument("--specs", type=Path, default=SPECS, help="where the patched spec versions live")
    args = ap.parse_args(argv)
    run_dir = Path(args.run_dir)
    problem = args.problem
    if problem is None:
        names = sorted({p.parent.parent.name for p in run_dir.glob("*/checkpoint_*/evaluation.json")})
        if len(names) != 1:
            sys.exit(f"pass --problem: found {names or 'no'} evaluated problems under {run_dir}")
        problem = names[0]
    root = problem_root(run_dir.resolve(), problem, args.specs)
    entries = registry(run_dir, problem)
    misses = gather(run_dir, problem, root, entries)
    text = "\n".join(brief(misses, entries) if args.brief else report(run_dir, problem, root, misses, entries))
    if args.out:
        Path(args.out).write_text(text)
        print(f"wrote {args.out}: {len(misses)} failing tests")
    else:
        print(text)


if __name__ == "__main__":
    main()
