index 9c48b6c..e7fffff 100644
--- a/tests/evaluation/config_test.py
+++ b/tests/evaluation/config_test.py
@@ -230,3 +230,54 @@ class TestProblemConfigTestDependencies:
             test_dependencies=["requests"],
         )
         assert config.test_dependencies == ["requests"]
+
