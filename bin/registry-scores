#!/usr/bin/env python3
"""Risk (v10) or Differs (v9) scores of a run's AMBIGUITIES.md: count, spread, the top entries,
and any entry matching a pattern.

Usage: bin/registry-scores <run_dir> [checkpoint_N] [--grep REGEX] [--full] [--top N]
Reads <run_dir>/<problem>/checkpoint_N/snapshot/AMBIGUITIES.md (last checkpoint by default) and
accepts every entry style seen so far (### Differs sections, ### Risk: N headings, **Differs** — N and
**Differs** N lines, Risk spelled the same ways). --grep prints the Choice and Risk text of entries
whose heading, quoted spec text or id (`^T8$`) matches, which is how a known flip is checked;
with --full it prints those entries whole, verbatim, which is what a spec pitch quotes. A run
that kept no registry (just-solve, anti-slop) says so and exits 1.

bin/miss-report ranks the entries near a failing test with `words` and `near` from here.
"""

import argparse
import collections
import math
import pathlib
import re

ID_NOISE = {"test", "tests", "case", "cases", "core", "hidden", "error", "errors", "correct",
            "checkpoint", "functionality", "the", "and", "for", "with", "not"}
NAME_WEIGHT = 6  # of the few misses whose entry is known, this put the most in the top three


def entries(text):
    out = []
    for e in re.split(r"(?m)^(?=## [TI]\d+)", text):
        h = re.match(r"## ([TI]\d+)[^\n]*", e)
        if not h:
            continue
        d = re.search(r"(?is)(?:###\s*(?:Differs|Risk)\s*:?\s*|\*\*(?:Differs|Risk)\*\*\s*[—:-]*\s*)(\d+)", e)
        c = re.search(r"(?is)(?:###\s*Choice\s*\n|\*\*Choice\*\*\s*[—:-]*\s*)(.*?)(?=\n###|\n\*\*[A-Z]|\Z)", e)
        dt = re.search(
            r"(?is)(?:###\s*(?:Differs|Risk)\s*:?\s*|\*\*(?:Differs|Risk)\*\*\s*[—:-]*\s*)(.*?)(?=\n###|\n\*\*[A-Z]|\Z)",
            e,
        )
        out.append(
            {
                "id": h.group(1),
                "text": e,
                "head": h.group(0)[3:].strip(),
                "score": int(d.group(1)) if d else None,
                "choice": re.sub(r"\s+", " ", c.group(1)).strip() if c else "",
                "differs": re.sub(r"\s+", " ", dt.group(1)).strip() if dt else "",
            }
        )
    return out


def registry(run_dir, checkpoint=None):
    problems = [p for p in pathlib.Path(run_dir).iterdir() if p.is_dir() and any(p.glob("checkpoint_*"))]
    cks = sorted(problems[0].glob("checkpoint_*"), key=lambda p: int(p.name.split("_")[1]))
    ck = problems[0] / checkpoint if checkpoint else cks[-1]
    return ck / "snapshot" / "AMBIGUITIES.md"


def matching(rows, pattern):
    """Entries whose id, heading or quoted spec lines match; the quote is where a sentence's
    own words are, and headings paraphrase them."""
    def haystack(row):
        quoted = " ".join(line for line in row["text"].splitlines() if line.startswith(">"))
        return f"{row['head']} {quoted}"
    return [r for r in rows if re.search(pattern, r["id"], re.I) or re.search(pattern, haystack(r), re.I)]


def words(text):
    """The lowercase words of a test id or an entry: camelCase split, digits dropped, and without
    the short words and the ones every test id carries."""
    spaced = re.sub(r"(?<=[a-z])(?=[A-Z])", " ", text)
    found = (re.sub(r"\d", "", w) for w in re.split(r"[^A-Za-z0-9]+", spaced.lower()))
    return {w for w in found if len(w) > 2 and w not in ID_NOISE}


def same_word(a, b):
    """Equal, or a plural and its singular: entries/entry, aliases/alias, types/type."""
    a, b = sorted((re.sub(r"ies$", "y", w) for w in (a, b)), key=len)
    return a == b or (len(a) >= 4 and len(b) - len(a) <= 3 and b.startswith(a))


def near(rows, wanted, named=frozenset()):
    """[(entry, the wanted words it shares)], best first. A shared word counts for more the fewer
    entries have it, and for nothing when every entry has it; one of the `named` words (the test's
    own name) counts NAME_WEIGHT times; a long entry is marked down, since it shares words with
    everything. Ties go to the higher Risk."""
    shared, length = {}, {}
    for r in rows:
        entry_words = words(r["text"])
        length[r["id"]] = max(len(entry_words), 1)
        hit = (w for w in wanted | named if any(same_word(w, e) for e in entry_words))
        shared[r["id"]] = sorted(hit, key=lambda w: (w not in named, w))  # the name's words lead
    spread = collections.Counter(w for hit in shared.values() for w in hit)
    weight = {
        r["id"]: sum((NAME_WEIGHT if w in named else 1) * math.log(len(rows) / spread[w]) for w in shared[r["id"]])
        / math.sqrt(length[r["id"]])
        for r in rows
    }
    ranked = sorted((r for r in rows if weight[r["id"]] > 0), key=lambda r: (-weight[r["id"]], -(r["score"] or 0)))
    return [(r, shared[r["id"]]) for r in ranked]


def registry_text(run_dir, checkpoint=None):
    path = registry(run_dir, checkpoint)
    if not path.exists():
        raise SystemExit(f"registry-scores: no AMBIGUITIES.md in {path.parent} (this prompt keeps no registry)")
    return path, path.read_text()


def main(argv=None):
    summary, usage = __doc__.split("\n\nUsage: ")
    parser = argparse.ArgumentParser(description=summary, usage=usage.splitlines()[0])
    parser.add_argument("run_dir")
    parser.add_argument("checkpoint", nargs="?", help="checkpoint_N; the last one by default")
    parser.add_argument("--grep", metavar="REGEX")
    parser.add_argument("--full", action="store_true")
    parser.add_argument("--top", type=int)
    args = parser.parse_args(argv)
    path, text = registry_text(args.run_dir, args.checkpoint)
    rows = entries(text)
    scored = [r for r in rows if r["score"] is not None]
    by_decade = dict(sorted(collections.Counter((r["score"] // 10) * 10 for r in scored).items()))
    print(
        f"{path.relative_to(args.run_dir) if str(path).startswith(str(args.run_dir)) else path}: "
        f"{len(rows)} entries, {len(scored)} scored, by decade {by_decade}"
    )
    for r in sorted(scored, key=lambda r: -r["score"])[: 6 if args.top is None else args.top]:
        print(f"  {r['score']:>3}  {r['head'][:90]}")
    if args.grep:
        for r in matching(rows, args.grep):
            if args.full:
                print(f"\n{r['text'].rstrip()}")
            else:
                print(
                    f"\n[{r['id']}] {r['head'][:100]} | Risk {r['score']}\n"
                    f"  Choice: {r['choice'][:400]}\n  Risk: {r['differs'][:300]}"
                )


if __name__ == "__main__":
    main()
