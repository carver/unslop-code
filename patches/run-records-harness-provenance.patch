+def _append_launcher_provenance(run_dir: Path) -> None:
+    """Append the launcher's record of the harness build (a JSON object in
+    SCB_HARNESS_PROVENANCE) to the run, one line per start or resume."""
+    record = os.environ.get(PROVENANCE_ENV)
+    if not record:
+        return
+    with (run_dir / PROVENANCE_FILENAME).open("a") as f:
+        f.write(json.dumps(json.loads(record), sort_keys=True) + "\n")
+
