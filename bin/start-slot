#!/usr/bin/env python3
"""Hold a fresh run back until no other run of its config started within the last two minutes.

    bin/start-slot <run-config.yaml>     # returns once the slot is this caller's

A run directory is named by its config's `save_template` and the minute it started
(`…/${now:%Y%m%dT%H%M}`), so two fresh runs with one template that start in the same minute
write into one directory. That is two runs of one config, and also runs of two configs that
share a prompt and a spec number (mvvault v1 and rejector v1 both save under `…-specv1/`), so
the slot is keyed by the template's prefix (slot_key), not by the config's name. With one
queue that cannot happen. With two channels (`bin/queue add --group`) it can, the first time
both start such a run at once. The
drivers call this just before they launch checkpoint 1; resumes name their directory and need
no slot. The gap is two minutes, not one, because scb takes some seconds to reach the line
that reads the clock, and a start at :59 must not land beside one at :01 of the next minute.

The last start of each config is a file under ~/.cache/scbench/start-slots/ (outside outputs/,
which the result tools walk), read and written under one lock, so the callers queue up behind
each other.
"""
import fcntl
import os
import pathlib
import sys
import re
import time

import yaml

GAP_S = 120


def wait_seconds(last, now, gap):
    """Seconds still to wait after a start at `last`; none for no earlier start or a clock that went backwards."""
    if last is None or now < last:
        return 0
    return max(0, gap - (now - last))


def slot_key(config_path):
    """What two runs must not share: the run directory's name up to its timestamp, from the
    config's `save_template`. Configs for different problems under one prompt and spec number
    (mvvault v1, rejector v1) share it, so the config's own name is not enough. A config that
    cannot be read, or that has no timestamp in its template, falls back to its file name."""
    path = pathlib.Path(config_path)
    try:
        template = yaml.safe_load(path.read_text()).get("save_template", "")
    except (OSError, yaml.YAMLError, AttributeError):
        return path.name
    prefix, stamp, _ = str(template).partition("${now")
    return re.sub(r"[^A-Za-z0-9._-]+", "_", prefix).strip("_") if stamp and prefix else path.name


def last_start(directory, config_name):
    path = pathlib.Path(directory) / config_name
    return float(path.read_text()) if path.exists() else None


def claim(directory, config_name, gap=GAP_S, now=time.time, sleep=time.sleep):
    """Wait the gap out under the lock, then record this start. Holding the lock while asleep is
    the point: a third caller must wait for the second one's start, not only the first's."""
    directory = pathlib.Path(directory)
    directory.mkdir(parents=True, exist_ok=True)
    with (directory / ".lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        wait = wait_seconds(last_start(directory, config_name), now(), gap)
        if wait:
            print(f"START-SLOT: another run of {config_name} started under {gap}s ago; waiting {wait:.0f}s", flush=True)
            sleep(wait)
        (directory / config_name).write_text(repr(now()))


def main():
    if len(sys.argv) != 2:
        raise SystemExit("usage: start-slot <run-config.yaml>")
    directory = os.environ.get("START_SLOT_DIR") or pathlib.Path.home() / ".cache" / "scbench" / "start-slots"
    claim(directory, slot_key(sys.argv[1]), gap=float(os.environ.get("START_SLOT_GAP", GAP_S)))


if __name__ == "__main__":
    main()
