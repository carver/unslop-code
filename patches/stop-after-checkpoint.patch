index bad364a..a4a50c1 100644
--- a/src/slop_code/evaluation/config.py
+++ b/src/slop_code/evaluation/config.py
@@ -819,6 +819,29 @@ class ProblemConfig(BaseConfig):
         for name, checkpoint in ordered:
             yield name, checkpoint
 
+    def limit_checkpoints(self, max_order: int) -> ProblemConfig:
+        """Return a copy keeping only checkpoints with order <= max_order.
+
+        Later checkpoints are dropped entirely, so downstream code (resume
+        detection, progress totals, evaluation) behaves as if the problem
+        ended at max_order.
+
+        Raises:
+            ConfigError: If no checkpoint has order <= max_order.
+        """
+        kept = {
+            name: checkpoint
+            for name, checkpoint in self.checkpoints.items()
+            if checkpoint.order <= max_order
+        }
+        if not kept:
+            raise ConfigError(
+                f"No checkpoint in problem {self.name} has order <= {max_order}"
+            )
+        if len(kept) == len(self.checkpoints):
+            return self
+        return self.model_copy(deep=True, update={"checkpoints": kept})
+
     def get_checkpoint_spec(self, checkpoint_name: str) -> str:
         """Get the specification text for a checkpoint.
 
