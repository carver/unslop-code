index 0000000..609cce7
--- /dev/null
+++ b/tests/agent_runner/prompt_context_test.py
@@ -0,0 +1,107 @@
+"""Live prompt rendering and resume validation must agree.
+
+Resume compares each saved prompt against a re-render; any context variable
+available to one renderer but not the other silently invalidates completed
+checkpoints. These tests pin the two renderers to identical output.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from slop_code.agent_runner import runner
+from slop_code.agent_runner.resume import _generate_expected_prompt
+from slop_code.evaluation.config import CheckpointConfig
+from slop_code.evaluation.config import ProblemConfig
+from slop_code.execution import LocalEnvironmentSpec
+from slop_code.execution.models import CommandConfig
+from slop_code.execution.models import EnvironmentConfig
+from slop_code.execution.models import SetupConfig
+
+TEMPLATE = (
+    "checkpoint={{ checkpoint_name }}#{{ checkpoint_number }} "
+    "continuation={{ is_continuation }} "
+    "agent={{ agent_type }}@{{ agent_version }} model={{ model_name }}\n"
+    "{{ spec.strip() }}"
+)
+
+
+def _environment() -> LocalEnvironmentSpec:
+    return LocalEnvironmentSpec(
+        name="local",
+        type="local",
+        setup=SetupConfig(eval_commands=[]),
+        environment=EnvironmentConfig(include_os_env=True),
+        commands=CommandConfig(command="uv run", entry_file="{entry_file}.py"),
+    )
+
+
+def _problem() -> ProblemConfig:
+    return ProblemConfig(
+        name="test",
+        path=Path("/test"),
+        version=1,
+        description="Test problem",
+        entry_file="main",
+        tags=["test"],
+        checkpoints={
+            "checkpoint_2": CheckpointConfig(
+                name="checkpoint_2",
+                version=1,
+                order=2,
+                spec_override="Do the thing.",
+            )
+        },
+    )
+
+
+def test_live_and_resume_renders_are_identical(tmp_path: Path) -> None:
+    problem = _problem()
+    environment = _environment()
+    checkpoint = problem.checkpoints["checkpoint_2"]
+
+    live = runner.get_task_for_checkpoint(
+        checkpoint_name=checkpoint.name,
+        spec_text=problem.get_checkpoint_spec(checkpoint.name),
+        template=TEMPLATE,
+        entry_file=problem.entry_file,
+        environment=environment,
+        is_first_checkpoint=False,
+        output_path=tmp_path,
+        checkpoint_number=checkpoint.order,
+        agent_type="claude_code",
+        agent_version="2.1.251",
+        model_name="opus-5",
+    )
+    expected = _generate_expected_prompt(
+        problem,
+        checkpoint,
+        TEMPLATE,
+        environment,
+        problem.entry_file,
+        is_first_checkpoint=False,
+        agent_type="claude_code",
+        agent_version="2.1.251",
+        model_name="opus-5",
+    )
+
+    assert live == expected
+    assert "checkpoint=checkpoint_2#2" in live
+    assert "agent=claude_code@2.1.251 model=opus-5" in live
+
+
+def test_unset_identity_fields_render_blank(tmp_path: Path) -> None:
+    problem = _problem()
+    checkpoint = problem.checkpoints["checkpoint_2"]
+
+    expected = _generate_expected_prompt(
+        problem,
+        checkpoint,
+        TEMPLATE,
+        _environment(),
+        problem.entry_file,
+        is_first_checkpoint=True,
+    )
+
+    assert "agent=@ model=" in expected
+    assert "checkpoint=checkpoint_2#2" in expected
