#!/usr/bin/env python3
"""Results across problems and prompts, generated from the run directories.

    bin/results [--write]      markdown table; --write also saves it to notes/results.md

One row per (problem, prompt, spec): final score, strict checkpoints, cost, and the four
quality means, averaged over the complete runs of that cell with the run count; score and strict
show a decimal mean and a min-max range only when the runs in the cell disagree. A run is
complete when it has every checkpoint the catalog lists for the problem; partial runs are
listed separately with the checkpoint they reached. The prompt is the run directory's name
after the model/agent/thinking prefix; spec is v0 (cached), v1, v2, ... from the run's catalog record
(a run against problems/<problem>-clarified.patch). Runs under outputs/dev6* and
outputs/spectest are scanned; a run is any directory holding checkpoint_results.jsonl.
Interpretation belongs in the per-problem ledger; this file is the numbers.
"""
import collections, json, os, pathlib, re, sys, types

HERE = pathlib.Path(__file__).resolve().parent
ROOT = HERE.parent
summarize = types.ModuleType("summarize"); summarize.__file__ = str(HERE / "summarize")
sys.modules["summarize"] = summarize
exec(compile((HERE / "summarize").read_text(), str(HERE / "summarize"), "exec"), summarize.__dict__)

PREFIX = "opus-5_2.1.251_high_"
CATALOG = pathlib.Path(os.path.expanduser("~/.cache/scbench/problems"))


def checkpoint_names(problem, run_dir=None):
    """Checkpoint names in the catalog this run actually used."""
    catalog = CATALOG
    if run_dir is not None:
        try:
            record = json.loads((run_dir / "problem_catalog.json").read_text())
            if record.get("version") == "env-override":
                recorded = pathlib.Path(os.path.expanduser(record.get("commit", "")))
                if recorded.is_dir():
                    catalog = recorded
        except (OSError, ValueError):
            pass
    return {p.stem for p in (catalog / problem).glob("checkpoint_*.md")}


def run_dirs(outputs=ROOT / "outputs"):
    return sorted(p.parent for p in outputs.glob("*/*/*/checkpoint_results.jsonl") if p.parent.parent.parent.name.startswith(("dev6", "spectest")))


MODEL_NAMES = {"fable-5-1": "fable-5.1"}  # registry alias -> the version spelling the table uses


SUFFIX = re.compile(r"-(disambiguated|specv\d+)$")
RUN_PREFIX = re.compile(r"^[^_]+_[^_]+_(?:low|medium|high|xhigh|max|ultra)_")


def spec_of(run_dir):
    """The spec version a run read: v0 is the cached benchmark spec, vN a specs/<problem>/vN/ build
    (or a specs/vN/ build from before versions were per problem).

    slop-code records the catalog in problem_catalog.json: the cache's version tag, or
    "env-override" with the SCBENCH_PROBLEMS_PATH it was given. Runs made before specs/
    existed read the patched copy at problems/, which was v1."""
    try:
        record = json.loads((run_dir / "problem_catalog.json").read_text())
    except (OSError, ValueError):
        return "v1" if run_dir.parent.name.endswith("-disambiguated") else "v0"
    if record.get("version") != "env-override":
        return "v0"
    m = re.search(r"/specs/(?:[^/]+/)?(v\d+)/problems/?$", record.get("commit", ""))
    return m.group(1) if m else "v1"


def cell_key(run_dir):
    name = RUN_PREFIX.sub("", run_dir.parent.name, count=1)
    model = run_dir.parent.name.split("_")[0]
    return SUFFIX.sub("", name), spec_of(run_dir), MODEL_NAMES.get(model, model)


def mean(xs):
    xs = [x for x in xs if x is not None]
    return sum(xs) / len(xs) if xs else None


def collect(dirs, checkpoints=checkpoint_names):
    """({(problem, prompt, spec, model): [per-run summaries]} for complete runs, [(problem, prompt, spec, run, reached, of)] for partial ones)."""
    cells = collections.defaultdict(list); partial = []
    for run in dirs:
        prompt, spec, model = cell_key(run)
        by_problem = collections.defaultdict(list)
        for r in summarize.load_rows(run):
            by_problem[r["problem"]].append(r)
        for problem, rows in by_problem.items():
            last = rows[-1]
            if last.get("passed_tests") is None:
                continue
            expected = checkpoints(problem, run)
            observed = {r.get("checkpoint") for r in rows}
            if not expected or not expected.issubset(observed):
                reached = len(observed & expected) if expected else len(observed)
                total = len(expected) if expected else "?"
                partial.append((problem, prompt, spec, run.parent.name.removeprefix(PREFIX) + "/" + run.name, reached, total, f"{last['passed_tests']}/{last['total_tests']}"))
                continue
            cells[(problem, prompt, spec, model)].append({
                "score": last["passed_tests"] / last["total_tests"], "passed": last["passed_tests"], "total": last["total_tests"],
                "strict": sum(r.get("strict_pass_rate", r.get("pass_rate")) == 1.0 for r in rows), "ckpts": len(rows),
                "cost": sum(r.get("cost") or 0 for r in rows), "minutes": sum(summarize.elapsed(r) for r in rows) / 60,
                "erosion": mean(r.get("erosion") for r in rows),
                "verbosity": mean(r.get("verbosity") for r in rows), "ast": mean(r.get("ast_grep_pct") for r in rows),
                "cloned": mean(r.get("cloned_pct") for r in rows)})
    return cells, partial


def fmt(v, d=3):
    return "-" if v is None else f"{v:.{d}f}"


def counted(values, total):
    """'399/405' when every run agrees, '398.5/405' and '397-400' when they differ."""
    if len(set(values)) == 1:
        return f"{values[0]}/{total}", "-"
    return f"{mean(values):.1f}/{total}", f"{min(values)}-{max(values)}"


def table(cells):
    out = ["| problem | prompt | spec | model | runs | score | range | strict | range | cc_$ | min | erosion | verbosity | ast% | cloned% |",
           "|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|"]
    for (problem, prompt, spec, model), runs in sorted(cells.items(), key=lambda kv: (kv[0][0], -mean(r["score"] for r in kv[1]), kv[0][1].removeprefix("spectest-"))):
        score, rng = counted([r["passed"] for r in runs], runs[0]["total"])
        strict, srng = counted([r["strict"] for r in runs], runs[0]["ckpts"])
        out.append(f"| {problem} | {prompt} | {spec} | {model} | {len(runs)} | {score} | {rng} | {strict} | {srng} | {mean(r['cost'] for r in runs):.0f} | {mean(r['minutes'] for r in runs):.0f} | "
                   f"{fmt(mean(r['erosion'] for r in runs))} | {fmt(mean(r['verbosity'] for r in runs))} | {fmt(mean(r['ast'] for r in runs))} | {fmt(mean(r['cloned'] for r in runs))} |")
    return "\n".join(out)


def partial_table(partial):
    out = ["| problem | prompt | spec | run | reached | last score |", "|---|---|---|---|---|---|"]
    out += [f"| {p} | {pr} | {sp} | `{run}` | {reached}/{of} | {score} |" for p, pr, sp, run, reached, of, score in sorted(partial)]
    return "\n".join(out)


def main():
    cells, partial = collect(run_dirs())
    text = ("# Results across problems\n\nGenerated by `bin/results --write`; do not edit. One row per problem, prompt and spec, "
            "means over the complete runs in that cell. Interpretation lives in `notes/<problem>-runs.md`.\n\n" + table(cells)
            + "\n\n## Partial runs (stopped, cut, or still running)\n\n" + partial_table(partial) + "\n")
    print(text)
    if "--write" in sys.argv:
        (ROOT / "notes" / "results.md").write_text(text)


if __name__ == "__main__":
    main()
