+def _has_infrastructure_failure(checkpoint_dir: Path) -> bool:
+    """True when a saved evaluation exists but cannot be trusted.
+
+    A checkpoint evaluated in a broken environment (e.g. offline dependency
+    installs) records infrastructure_failure in its evaluation.json; its
+    scores are meaningless even though the checkpoint state says "ran", so it
+    must be re-run. A missing evaluation.json is fine: runs started with
+    skip_evaluation never write one. An unreadable one is treated as failed,
+    since its scores cannot be trusted either.
+    """
+    eval_path = checkpoint_dir / EVALUATION_FILENAME
+    if not eval_path.exists():
+        return False
+    try:
+        with eval_path.open() as f:
+            evaluation = json.load(f)
+    except (OSError, json.JSONDecodeError):
+        return True
+    if not isinstance(evaluation, dict):
+        return True
+    return bool(evaluation.get("infrastructure_failure", False))
+
