#!/usr/bin/env python3
"""Extend a run that stopped early: resume it one checkpoint at a time, between 5-hour windows.

Usage: bin/scb-extend <run_dir> <problem> <n_checkpoints>
       bin/scb-extend --new <run-config.yaml> <problem> <n_checkpoints>   (start a fresh run)

Each checkpoint is its own `scb run --resume --stop-after-checkpoint N`, so a halt lands
between checkpoints and never inside one. Before each checkpoint the 5-hour window is read
(bin/usage); if the checkpoint might not fit before the reset, sleep through the reset
rather than have the agent die rate-limited mid-checkpoint. The reading before and after
every checkpoint is appended to <run_dir>/<problem>/window_usage.jsonl, so the window cost
of a checkpoint is measured, and the reserve kept for the next one is 1.25x the largest
measured cost (default 30 points until one is measured).

Unlike bin/scb-strict, a failing test does not halt; these runs are expected to miss.
A checkpoint whose agent run errored (had_error in inference_result.json) is not finished.
If the agent's transcript shows the API was overloaded, the driver sleeps OVERLOAD_WAIT_S
and re-runs the checkpoint, up to OVERLOAD_TRIES times; any other agent error is re-run
once and halts if it recurs. Only that, a missing evaluation, an infrastructure failure,
or scb itself failing halts.

Before each resume, run_info.yaml is checked against the checkpoint directories. A resume
that ends in an error rewrites run_info.yaml with every checkpoint it did not itself run
marked "skipped", and the next resume trusts that file and deletes those directories
(this destroyed v4's checkpoints 1 and 2 on 2026-09-02). A finished checkpoint whose
state is not "ran" is set back to "ran", with the old file kept as run_info.yaml.bak-<ts>.
Then `scb run --resume --dry-run` previews the resume, and the driver halts (exit 5) if the
preview would delete a finished checkpoint, whatever the reason. Every finished checkpoint
is also tarred once into outputs/backups/ before the next resume touches the run.
A run with several problems is resumed one problem at a time: the child scb gets
SCB_RESUME_ONLY_PROBLEM=<problem>, which patches/resume-only-problem.patch teaches it to honour.
Progress lines start with EXTEND: so a log watcher can filter on them.
Exit codes:
    0 all checkpoints ran
    3 checkpoint left no usable evaluation
    4 scb failed
    5 the resume preview would delete a finished checkpoint
    6 usage quota reached
"""
import os
import datetime
import json
import pathlib
import re
import shutil
import subprocess
import sys
import time

import yaml

HERE = pathlib.Path(__file__).resolve().parent
ROOT = HERE.parent  # run configs name their paths relative to it, so scb runs from it
DEFAULT_RESERVE = 30.0
RESET_SLACK_S = 90
OVERLOAD_WAIT_S = 15 * 60
OVERLOAD_TRIES = 8


def next_checkpoint(problem_dir, total):
    for n in range(1, total + 1):
        if not finished(problem_dir, n):
            return n
    return None


def overloaded(ckpt_dir):
    """The agent run died on API capacity: overloaded or server_error events in its transcript and no tool use."""
    try:
        text = (ckpt_dir / "agent" / "stdout.jsonl").read_text()
    except OSError:
        return False
    return ('"error":"overloaded"' in text or '"error":"server_error"' in text) and '"tool_use"' not in text


def quota_error(ckpt_dir):
    """Read explicit Codex failure events, not arbitrary solver/tool text."""
    path = ckpt_dir / "agent" / "stdout.jsonl"
    if not path.exists():
        return None
    for line in path.read_text().splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if event.get("type") == "error":
            message = event.get("message", "")
        elif event.get("type") == "turn.failed":
            message = (event.get("error") or {}).get("message", "")
        else:
            continue
        if "usage limit" in message.lower() or "usage_limit_reached" in message.lower():
            return message
    return None


def halt_on_quota(ckpt_dir):
    if not agent_errored(ckpt_dir):
        return
    message = quota_error(ckpt_dir)
    if message is None:
        return
    # Pause scheduling, without killing this task or touching its artifacts.
    pueue = pathlib.Path.home() / ".local/bin/pueue"
    result = subprocess.run([pueue, "pause", "--wait"], capture_output=True, text=True)
    say(f"usage limit: {message}; halting with checkpoint preserved; queue pause exit={result.returncode}")
    if result.returncode:
        say(f"queue pause failed: {result.stderr.strip()}")
    raise SystemExit(6)


def agent_errored(ckpt_dir):
    try:
        return bool(json.loads((ckpt_dir / "inference_result.json").read_text()).get("had_error"))
    except (OSError, ValueError):
        return True


def repair_run_info(problem_dir, total, now=None):
    """Return the finished checkpoints whose run_info state was not 'ran', after fixing them."""
    path = problem_dir / "run_info.yaml"
    if not path.exists():
        return []
    info = yaml.safe_load(path.read_text()) or {}
    states = info.setdefault("summary", {}).setdefault("checkpoints", {}) or {}
    wrong = [f"checkpoint_{n}" for n in range(1, total + 1) if finished(problem_dir, n) and states.get(f"checkpoint_{n}") != "ran"]
    if wrong:
        now = now or datetime.datetime.now(datetime.timezone.utc)
        shutil.copy2(path, path.with_name(f"run_info.yaml.bak-{now:%Y%m%dT%H%M%S}"))
        for name in wrong:
            states[name] = "ran"
        info["summary"]["checkpoints"] = states
        path.write_text(yaml.safe_dump(info, sort_keys=False))
    return wrong


def deletions(dry_run_output):
    """Checkpoint directories a `--resume --dry-run` preview says it would delete."""
    paths = []
    listing = False
    for line in dry_run_output.splitlines():
        if line.strip() == "Directories to delete:":
            listing = True
        elif listing and line.strip().startswith("- "):
            paths.append(pathlib.Path(line.strip()[2:]))
        elif listing and line.strip():
            listing = False
    return paths


def finished_dir(path):
    """A checkpoint the agent completed: evaluated without an infrastructure failure, snapshotted, and its agent run did not error."""
    return (all((path / f).exists() for f in ("evaluation.json", "inference_result.json", "snapshot"))
            and not agent_errored(path) and not infra_failed(path))


def infra_failed(ckpt_dir):
    """The evaluation never ran the tests (a network outage during its package install, for one); the checkpoint must be redone."""
    try:
        return bool(json.loads((ckpt_dir / "evaluation.json").read_text()).get("infrastructure_failure"))
    except (OSError, ValueError):
        return True


def backup_dir():
    return HERE.parent / "outputs" / "backups"


def backup_finished(run_dir, problem, total):
    """Tar each finished checkpoint into outputs/backups once; return the names tarred now."""
    problem_dir = run_dir / problem
    done = []
    for n in range(1, total + 1):
        if not finished(problem_dir, n):
            continue
        tgz = backup_dir() / f"{run_dir.parent.name}-{run_dir.name}-{problem}-checkpoint_{n}.tgz"
        if tgz.exists():
            continue
        tgz.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["tar", "czf", str(tgz), "-C", str(problem_dir), f"checkpoint_{n}", "run_info.yaml"], check=True)
        done.append(f"checkpoint_{n}")
    return done


def output_dir_from(text):
    """The run directory scb announced, absolute: a relative save_dir is relative to the repo root."""
    m = re.search(r"Output directory: (\S+)", re.sub(r"\x1b\[[0-9;]*m", "", text))
    return ROOT / m.group(1) if m else None


def launcher():
    return pathlib.Path(os.environ.get("SCB_LAUNCHER", str(HERE / "scb")))


def resume_command(run_dir, problem, n):
    """The scb invocation that runs checkpoint n of one problem of a run, and its environment.
    SCB_RESUME_ONLY_PROBLEM narrows the resume to that problem (patches/resume-only-problem.patch).
    Upstream's own --problem is not used: on a resume it merges into the run's saved list, so
    it cannot narrow a multi-problem run."""
    argv = [launcher(), "run", "--resume", str(run_dir), "--no-live-progress", "--stop-after-checkpoint", str(n)]
    return argv, {**os.environ, "SCB_RESUME_ONLY_PROBLEM": problem}


def start_run(config):
    """Run checkpoint 1 of a fresh run from a config; stream scb's output and return (run_dir, returncode)."""
    proc = subprocess.Popen([launcher(), "run", "--config", str(config), "--no-live-progress", "--stop-after-checkpoint", "1"],
                            cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    run_dir = None
    for line in proc.stdout:
        print(line, end="", flush=True)
        run_dir = run_dir or output_dir_from(line)
    return run_dir, proc.wait()


def finished(problem_dir, n):
    return finished_dir(problem_dir / f"checkpoint_{n}")


def outcome(problem_dir, n):
    ev = problem_dir / f"checkpoint_{n}" / "evaluation.json"
    if not ev.exists():
        return None
    d = json.loads(ev.read_text())
    return sum(d["pass_counts"].values()), sum(d["total_counts"].values()), bool(d.get("infrastructure_failure"))


def window_id(resets_at):
    """The reset time to the nearest minute. Readings of one window report it with sub-second
    jitter, sometimes across a second boundary, so the raw string never pairs a before with its after."""
    if not resets_at:  # a reading at 0% carries no reset time
        return None
    ts = datetime.datetime.fromisoformat(resets_at).timestamp()
    return int(round(ts / 60))


def window_costs(records):
    """Points of the 5-hour window each finished checkpoint used, from before/after readings in the same window."""
    before = {}
    costs = []
    for r in records:
        if not r.get("five_hour"):
            continue
        wid = window_id(r["five_hour"].get("resets_at"))
        if wid is None:
            continue
        key = (r["checkpoint"], wid)
        if r["phase"] == "before":
            before[key] = r["five_hour"]["pct"]
        elif key in before:
            costs.append(r["five_hour"]["pct"] - before[key])
    return [c for c in costs if c > 0]


def reserve(records, prior=()):
    """Window points to keep free before starting a checkpoint: this run's costliest checkpoint
    plus a quarter, else the same from recent runs of the problem, else DEFAULT_RESERVE."""
    costs = window_costs(records) or list(prior)
    return max(costs) * 1.25 if costs else DEFAULT_RESERVE


def prior_costs(problem, outputs=None, runs=3):
    """Checkpoint window costs from the most recent `runs` runs of `problem` under outputs/."""
    outputs = outputs or HERE.parent / "outputs"
    logs = sorted(outputs.glob(f"*/*/*/{problem}/window_usage.jsonl"), key=lambda p: p.stat().st_mtime)
    costs = []
    for log in logs[-runs:]:
        records = [json.loads(line) for line in log.read_text().splitlines() if line.strip()]
        costs += window_costs(records)
    return costs


def seconds_until_room(reading, needed, now):
    w = reading.get("five_hour")
    if not w:
        return 0
    if w["pct"] + needed <= 100:
        return 0
    resets = datetime.datetime.fromisoformat(w["resets_at"])
    return max(0, (resets - now).total_seconds()) + RESET_SLACK_S


def usage(attempts=5, pause=30):
    """The 5-hour window reading, or None if bin/usage keeps failing.

    The endpoint has brief outages and rate-limits with 429 when polled too often; a 429
    doubles the pause each attempt (30, 60, 120, 240 s) instead of asking again at once."""
    if os.environ.get("SCB_USAGE_TRACKING") == "0":
        return None
    for i in range(attempts):
        proc = subprocess.run([HERE / "usage"], capture_output=True, text=True)
        if proc.returncode == 0:
            return json.loads(proc.stdout)
        reason = usage_failure(proc.stderr)
        say(f"bin/usage failed (attempt {i + 1}/{attempts}): {reason}")
        if i + 1 < attempts:
            time.sleep(pause * 2 ** i if reason.startswith("HTTP 429") else pause)
    return None


def usage_failure(stderr):
    """A one-line reason from bin/usage's stderr: the HTTP status when there is one."""
    m = re.search(r"HTTP Error (\d+)(?::\s*([^\n]*))?", stderr)
    if m:
        return f"HTTP {m.group(1)} {m.group(2) or ''}".strip()
    return stderr.strip().splitlines()[-1][-120:] if stderr.strip() else "no output"


def pct(reading):
    w = reading.get("five_hour")
    return f"{w['pct']}%" if w else "unknown"


def say(msg):
    print(f"EXTEND: {msg} {datetime.datetime.now(datetime.timezone.utc):%H:%M:%SZ}", flush=True)


def main():
    args = sys.argv[1:]
    fresh = args[0] == "--new"
    if fresh:
        args = args[1:]
    target = pathlib.Path(args[0]).resolve()
    problem = args[1]
    total = int(args[2])
    records = []
    prior = prior_costs(problem)
    log = None

    def record(n, phase):
        r = {"checkpoint": n, "phase": phase, **(usage() or {"five_hour": None})}
        records.append(r)
        if log is not None:
            with log.open("a") as f:
                f.write(json.dumps(r) + "\n")
        return r

    def wait_for_room(n):
        reading = record(n, "before")
        wait = seconds_until_room(reading, reserve(records, prior), datetime.datetime.now(datetime.timezone.utc))
        if wait:
            say(f"window at {pct(reading)} with {reserve(records, prior):.0f} needed; sleeping {wait/60:.0f} min until reset")
            time.sleep(wait)
            reading = record(n, "before")
        return reading

    if fresh:
        reading = wait_for_room(1)
        say(f"starting a fresh run from {target.name}, checkpoint_1 (window {pct(reading)})")
        run_dir, code = start_run(target)
        if run_dir is None:
            say(f"scb printed no output directory (exit {code}); halting")
            sys.exit(4)
        say(f"run_dir={run_dir}")
    else:
        run_dir = target
    problem_dir = run_dir / problem
    log = problem_dir / "window_usage.jsonl"
    if log.exists():
        records = [json.loads(line) for line in log.read_text().splitlines() if line.strip()] + records
    if fresh:
        with log.open("a") as f:
            for r in records:
                f.write(json.dumps(r) + "\n")
        after = record(1, "after")
        halt_on_quota(problem_dir / "checkpoint_1")
        res = outcome(problem_dir, 1)
        if res is None:
            say(f"checkpoint_1 left no evaluation; halting (run_dir={run_dir})")
            sys.exit(3)
        errored = agent_errored(problem_dir / "checkpoint_1")
        say(f"checkpoint_1 {res[0]}/{res[1]} infra_fail={res[2]} agent_error={errored} window {pct(reading)} -> {pct(after)}")
        if res[2] or (code != 0 and not errored):
            sys.exit(3 if res[2] else 4)
        if errored:
            say("checkpoint_1 agent run errored; the resume loop re-runs it")

    retried = set()
    overloads = 0
    while (n := next_checkpoint(problem_dir, total)) is not None:
        for name in repair_run_info(problem_dir, total):
            say(f"run_info.yaml had finished {name} marked not-ran; set to ran so resume keeps it")
        for name in backup_finished(run_dir, problem, total):
            say(f"backed up {name} to {backup_dir()}")
        reading = wait_for_room(n)
        resume, env = resume_command(run_dir, problem, n)
        preview = subprocess.run(resume + ["--dry-run"], env=env, capture_output=True, text=True)
        doomed = [d for d in deletions(preview.stdout) if finished_dir(d)]
        if preview.returncode != 0 or doomed:
            say(f"resume preview would delete finished {[d.name for d in doomed]} (exit {preview.returncode}); halting")
            print(preview.stdout[-2000:], preview.stderr[-1000:], sep="\n", flush=True)
            sys.exit(5)
        say(f"starting checkpoint_{n} (window {pct(reading)})")
        proc = subprocess.run(resume, env=env)
        after = record(n, "after")
        if proc.returncode != 0:
            say(f"scb exited {proc.returncode} on checkpoint_{n}")
        halt_on_quota(problem_dir / f"checkpoint_{n}")
        res = outcome(problem_dir, n)
        if res is None:
            say(f"checkpoint_{n} left no evaluation; halting (run_dir={run_dir})")
            sys.exit(3)
        passed, tests, infra = res
        errored = agent_errored(problem_dir / f"checkpoint_{n}")
        say(f"checkpoint_{n} {passed}/{tests} infra_fail={infra} agent_error={errored} window {pct(reading)} -> {pct(after)}")
        if infra:
            say(f"checkpoint_{n} infrastructure failure; halting (run_dir={run_dir})")
            sys.exit(3)
        if errored:
            if overloaded(problem_dir / f"checkpoint_{n}"):
                overloads += 1
                if overloads > OVERLOAD_TRIES:
                    say(f"API overloaded {overloads} times; halting (run_dir={run_dir})")
                    sys.exit(3)
                say(f"checkpoint_{n} died on API overload ({overloads}/{OVERLOAD_TRIES}); sleeping {OVERLOAD_WAIT_S // 60} min, then re-running it")
                time.sleep(OVERLOAD_WAIT_S)
                continue
            if n in retried:
                say(f"checkpoint_{n} agent run errored twice; halting (run_dir={run_dir})")
                sys.exit(3)
            retried.add(n)
            say(f"checkpoint_{n} agent run errored; re-running it once")
            continue
        if proc.returncode != 0:
            sys.exit(4)
    say(f"DONE, {total} checkpoints present (run_dir={run_dir})")
    say(f"next: bin/ledger-row {run_dir} -> notes/{problem}-runs.md (table row + failure summary); bin/compare-runs for the ladder section")


if __name__ == "__main__":
    main()
